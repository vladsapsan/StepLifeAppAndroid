<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BottomSheetDialog" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
        <item name="android:windowEnterAnimation">@anim/sheet_slide_up</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowEnterAnimation">@anim/sheet_slide_up</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>

    <style name="CustomCardViewStyle" parent="@style/Widget.Material3.CardView.Elevated">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay_card_custom_corners</item>
    </style>

    <style name="Theme" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:background">@color/MainYellow</item>
        <item name="android:windowBackground">@color/MainYellow</item>
    </style>

    <style name="ShapeAppearanceOverlay_card_custom_corners" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeTopLeft">13dp</item>
        <item name="cornerSizeBottomRight">13dp</item>
        <item name="backgroundTint">@color/white</item>
        <item name="background">@color/white</item>
        <item name="backgroundColor">@color/white</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>



    <style name="CustomNavigationMenu" parent="Widget.Design.BottomNavigationView">


    </style>

    <style name="Widget.Theme.StepLifeApp.ButtonBar.Fullscreen" parent="">
        <item name="android:background">@color/black_overlay</item>
        <item name="android:buttonBarStyle">?android:attr/buttonBarStyle</item>
    </style>

    <style name="AppTheme" parent="Theme.Material3.Light">
        <item name="pinViewStyle">@style/PinWidget.PinView</item>
    </style>
</resources>