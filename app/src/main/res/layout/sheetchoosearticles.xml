<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:animateLayoutChanges="true"
    android:id="@+id/SheetDialogChooseArticleContainer"
    android:background="@drawable/bottomsheetprofilesettingbackground"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="0dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="match_parent">
            <FrameLayout
                android:layout_width="60dp"
                android:layout_marginTop="5dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/cornerdefault"
                android:layout_height="5dp"/>
            <TextView
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="10dp"
                android:fontFamily="@font/montserrat1black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Выберите статью для загрузки"
                android:textColor="@color/black"
                android:textSize="13dp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_marginBottom="0dp"
                android:layout_height="wrap_content">
                <ListView
                    android:footerDividersEnabled="false"
                    android:divider="@null"
                    android:paddingTop="10dp"
                    android:animateLayoutChanges="false"
                    android:id="@+id/AllArticleListview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
        </LinearLayout>

    </FrameLayout>

</FrameLayout>