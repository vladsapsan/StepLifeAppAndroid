<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:layout_width="115dp"
        app:cardCornerRadius="5dp"
        android:layout_gravity="left"
        android:layout_marginBottom="5dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="5dp"
        android:layout_height="115dp">

        <ImageView
            android:id="@+id/PreviewPhoto"
            android:layout_width="match_parent"
            app:srcCompat="@drawable/protez1"
            android:scaleType="fitXY"
            android:layout_height="match_parent"/>
        <ProgressBar
            android:visibility="gone"
            android:id="@+id/progressBarDownloadpreviewPhotoArticle"
            style="?android:attr/progressBarStyle"
            android:layout_gravity="center"
            android:indeterminateTint="@color/MainBlue"
            android:layout_width="22dp"
            android:layout_height="22dp" />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_marginLeft="135dp"
        android:orientation="vertical"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/ArticleTypeTextItems"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:singleLine="true"
            android:fontFamily="@font/normalidadextended1thin"
            android:text="Статья"
            android:textColor="@color/MainGrayText"
            android:textSize="14dp" />

        <TextView
            android:id="@+id/ArticleHeadTextItems"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingRight="10dp"
            android:includeFontPadding="false"
            android:fontFamily="@font/montserratsemibold"
            android:gravity="left"

            android:text="Как получить протез бесплатно?"
            android:textColor="@color/BlackSviut"
            android:textSize="15sp" />

        <TextView
            android:contextClickable="false"
            android:layout_marginTop="10dp"
            android:id="@+id/ArticleDateTextItems"

            android:singleLine="true"
            android:clickable="false"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Дата публикации"
            android:fontFamily="@font/montserratregular"
            android:textColor="@color/MainGrayText"
            android:background="@null"
            android:textSize="12dp" />

    </LinearLayout>

</FrameLayout>