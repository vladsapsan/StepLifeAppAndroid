<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="15dp"
        android:background="@color/TranspanetColor"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="5dp"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:layout_width="100dp"
            app:cardCornerRadius="7dp"
            android:layout_gravity="center_vertical"
            android:layout_marginBottom="10dp"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            android:layout_height="100dp">
            <ImageView
                android:adjustViewBounds="true"
                android:id="@+id/PreviewPhoto"
                android:layout_width="match_parent"
                android:scaleType="centerCrop"
                android:layout_height="match_parent"/>
            <ProgressBar
                android:visibility="gone"
                android:id="@+id/progressBarDownloadpreviewPhotoArticle"
                style="?android:attr/progressBarStyle"
                android:layout_gravity="center"
                android:indeterminateTint="@color/MainBlue"
                android:layout_width="22dp"
                android:layout_height="22dp" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_marginLeft="135dp"
            android:orientation="vertical"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_marginBottom="1dp"
                    android:id="@+id/ArticleTypeTextItems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:singleLine="true"
                    android:fontFamily="@font/normalidad_extended_extreg"
                    android:text="Статья"
                    android:textColor="@color/MainGrayText"
                    android:textSize="14dp" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|right"
                    android:orientation="horizontal">
                    <androidx.cardview.widget.CardView
                        android:visibility="gone"
                        android:id="@+id/AddTagsArticleCard"
                        android:layout_marginLeft="4dp"
                        android:layout_marginTop="3dp"
                        android:layout_marginRight="5dp"
                        android:layout_marginBottom="2dp"
                        app:cardElevation="1dp"
                        android:layout_width="wrap_content"
                        android:layout_gravity="right|bottom"
                        app:cardCornerRadius="10dp"
                        android:backgroundTint="@color/MainGray"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/TextviewTag"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:layout_marginBottom="3dp"
                            android:layout_marginRight="9dp"
                            android:layout_marginLeft="9dp"
                            android:textColor="@color/MainGrayText"
                            android:fontFamily="@font/montserrat_bold"
                            android:textSize="10dp"
                            android:text="Тег"
                            />
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:visibility="gone"
                        android:id="@+id/MoreTagsArticle"
                        android:layout_marginTop="3dp"
                        android:layout_marginRight="5dp"
                        android:layout_marginBottom="2dp"
                        android:layout_width="wrap_content"
                        android:layout_gravity="right|bottom"
                        app:cardElevation="1dp"
                        app:cardCornerRadius="50dp"
                        android:backgroundTint="@color/MainGray"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/TextviewMoreTag"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:layout_marginBottom="3dp"
                            android:layout_marginRight="8dp"
                            android:layout_marginLeft="8dp"
                            android:textColor="@color/MainGrayText"
                            android:fontFamily="@font/montserrat_bold"
                            android:textSize="10dp"
                            android:text="+1"
                            />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

            </FrameLayout>


            <TextView
                android:id="@+id/ArticleHeadTextItems"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingRight="10dp"
                android:breakStrategy="high_quality"
                android:includeFontPadding="false"
                android:fontFamily="@font/montserrat_semibold"
                android:gravity="left"
                android:text="Как получить протез бесплатно?"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:contextClickable="false"
                android:layout_marginTop="10dp"
                android:id="@+id/ArticleDateTextItems"

                android:layout_marginBottom="10dp"
                android:singleLine="true"
                android:clickable="false"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Дата публикации"
                android:fontFamily="@font/montserrat_semibold"
                android:textColor="@color/MainGrayText"
                android:background="@null"
                android:textSize="12dp" />

        </LinearLayout>
    </FrameLayout>


</FrameLayout>