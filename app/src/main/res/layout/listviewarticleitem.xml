<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">


    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        app:cardPreventCornerOverlap="false"
        style="@style/CustomCardViewStyle"

        app:cardBackgroundColor="@color/white"
        app:strokeWidth="0dp"
        app:cardElevation="4dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_height="90dp">
            <ImageView
                android:adjustViewBounds="true"
                android:id="@+id/PreviewPhoto"
                android:layout_width="112dp"
                android:scaleType="centerCrop"
                android:layout_height="90dp"/>
        <LinearLayout
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_width="match_parent"
            android:gravity="left"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="128dp"
            android:layout_marginRight="16dp"
            android:orientation="vertical"
            android:layout_height="wrap_content">
            <FrameLayout
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|right"
                    android:orientation="horizontal">
                    <androidx.cardview.widget.CardView
                        android:visibility="gone"
                        android:id="@+id/AddTagsArticleCard"
                        android:layout_marginLeft="4dp"
                        android:layout_marginTop="3dp"
                        android:layout_marginRight="5dp"
                        android:layout_marginBottom="2dp"
                        app:cardElevation="1dp"
                        android:layout_width="wrap_content"
                        android:layout_gravity="right|bottom"
                        app:cardCornerRadius="10dp"
                        android:backgroundTint="@color/MainGray"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/TextviewTag"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:layout_marginBottom="3dp"
                            android:layout_marginRight="9dp"
                            android:layout_marginLeft="9dp"
                            android:textColor="@color/MainGrayText"
                            android:fontFamily="@font/montserrat_bold"
                            android:textSize="10dp"
                            android:text="Тег"
                            />
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:visibility="gone"
                        android:id="@+id/MoreTagsArticle"
                        android:layout_marginTop="3dp"
                        android:layout_marginRight="5dp"
                        android:layout_marginBottom="2dp"
                        android:layout_width="wrap_content"
                        android:layout_gravity="right|bottom"
                        app:cardElevation="1dp"
                        app:cardCornerRadius="50dp"
                        android:backgroundTint="@color/MainGray"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/TextviewMoreTag"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:layout_marginBottom="3dp"
                            android:layout_marginRight="8dp"
                            android:layout_marginLeft="8dp"
                            android:textColor="@color/MainGrayText"
                            android:fontFamily="@font/montserrat_bold"
                            android:textSize="10dp"
                            android:text="+1"
                            />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

            </FrameLayout>


            <TextView
                android:id="@+id/ArticleHeadTextItems"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:breakStrategy="high_quality"
                android:includeFontPadding="false"
                android:fontFamily="@font/montserrat_medium"
                android:gravity="left"
                android:maxLines="3"
                android:ellipsize="end"
                android:text="Как получить протез бесплатно?"
                android:textColor="@color/BlackSviut"
                android:textSize="14sp" />


        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>


</FrameLayout>