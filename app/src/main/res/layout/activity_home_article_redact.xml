<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".StafFunction.TopPostRedactActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp">
            <ImageView
                android:clickable="true"
                android:id="@+id/imagebackEditHome"
                android:layout_width="40dp"
                android:layout_gravity="right"
                android:layout_height="40dp"
                android:padding="6dp"
                android:src="@drawable/close24px"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_marginTop="7dp"
                android:layout_marginLeft="10dp"
                android:fontFamily="@font/montserratsemibold"
                android:gravity="left"
                android:text="Главная страница"
                android:textColor="@color/BlackSviut"
                android:textSize="16sp" />

            <ProgressBar
                android:visibility="gone"
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyle"
                android:layout_gravity="right"
                android:layout_marginTop="8dp"
                android:layout_marginRight="10dp"
                android:indeterminateTint="@color/MainBlue"
                android:layout_width="25dp"
                android:layout_height="25dp" />
        </FrameLayout>


    <ScrollView
        android:overScrollMode="always"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">



        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ScrollView
                android:layout_width="match_parent"
                android:scrollbars="none"
                android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left|center_vertical"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:gravity="left"
                    android:text="Выберите разделы для загрузки на главной странице, нажав на кнопку выбрать"
                    android:textColor="@color/black"
                    android:textSize="14sp" />
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/normalidadextended_extbold"
                        android:text="Учебник"
                        android:textColor="@color/MainGrayText"
                        android:textSize="18dp" />

                    <androidx.cardview.widget.CardView
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_marginRight="10dp"
                        android:layout_marginTop="20dp"
                        app:cardCornerRadius="6dp"
                        android:backgroundTint="@color/secondBlue"
                        android:layout_marginBottom="5dp"
                        android:layout_gravity="right"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="4dp"
                            android:layout_marginRight="5dp"
                            android:layout_marginLeft="5dp"
                            android:textColor="@color/MainBlue"
                            android:fontFamily="@font/montserratsemibold"
                            android:textSize="13dp"
                            android:text="Редактирование"
                            />
                    </androidx.cardview.widget.CardView>
                </FrameLayout>






                <LinearLayout
                    android:id="@+id/CardArticleSection"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="5dp"
                    android:layout_height="wrap_content">
                    <androidx.cardview.widget.CardView
                        android:visibility="visible"
                        android:layout_marginRight="5dp"
                        android:layout_marginBottom="2dp"
                        android:layout_width="wrap_content"
                        android:layout_gravity="center"
                        app:cardElevation="1dp"
                        app:cardCornerRadius="50dp"
                        android:backgroundTint="@color/MainYellow"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/TextviewNumber"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="2dp"
                            android:layout_marginRight="8dp"
                            android:layout_marginLeft="8dp"
                            android:textColor="@color/BlackSviut"
                            android:fontFamily="@font/montserrat_bold"
                            android:textSize="14dp"
                            android:text="1"
                            />
                    </androidx.cardview.widget.CardView>
                    <TextView
                        android:textStyle="bold"
                        android:id="@+id/TextviewSectionName1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_gravity="center"
                        android:fontFamily="@font/montserrat_bold"
                        android:text=""
                        android:textColor="@color/SecondGrayText"
                        android:textSize="16dp"
                        app:layout_constraintBottom_toTopOf="@+id/horizontalScrollView"
                        app:layout_constraintStart_toStartOf="parent" />
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="5dp"
                        android:layout_width="16dp"
                        android:src="@drawable/arrow_forward_ios24px"
                        android:layout_height="16dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_marginTop="16dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <Button
                            android:id="@+id/SelectSectionHomeButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_semibold"
                            android:textSize="12dp"
                            app:icon="@drawable/library_add24px"
                            android:layout_marginLeft="16dp"
                            app:iconTint = "@color/white"
                            app:iconGravity = "textStart"
                            app:iconSize = "16dp"
                            android:layout_gravity="left"
                            android:backgroundTint="@color/MainBlue"
                            android:textColor="@color/white"
                            android:text="выбрать раздел"/>
                    </FrameLayout>
                </LinearLayout>
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none">
                    <LinearLayout
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingRight="20dp">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/CardHomeArticle1"
                            android:foreground="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="5dp"
                            android:layout_width="192dp"
                            android:layout_height="180dp"
                            android:layout_marginLeft="20dp"
                            app:cardCornerRadius="8dp">
                            <ImageView
                                android:scaleType="centerCrop"
                                android:clickable="false"
                                android:id="@+id/ImageHomeArticle1"
                                android:layout_width="match_parent"
                                android:layout_height="124dp" />
                            <TextView
                                android:id="@+id/TextHomeArticle1"
                                android:layout_width="match_parent"
                                android:layout_height="37dp"
                                android:layout_gravity="bottom"
                                android:layout_marginLeft="10dp"
                                android:layout_marginRight="10dp"
                                android:layout_marginBottom="10dp"
                                android:fontFamily="@font/montserratsemibold"
                                android:gravity="left"
                                android:text=""
                                android:textColor="@color/BlackSviut"
                                android:textSize="14sp" />

                            <ImageView
                                android:id="@+id/ImageAddTopHome1"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:src="@drawable/plus_insert_add_rectangle_icon" />
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/CardHomeArticle2"
                            android:foreground="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="5dp"
                            android:layout_width="192dp"
                            android:layout_height="180dp"
                            android:layout_marginLeft="20dp"
                            app:cardCornerRadius="8dp">
                            <ImageView

                                android:id="@+id/ImageHomeArticle2"
                                android:layout_width="match_parent"
                                android:scaleType="centerCrop"
                                android:layout_height="124dp" />
                            <TextView
                                android:id="@+id/TextHomeArticle2"
                                android:layout_width="match_parent"
                                android:layout_height="37dp"
                                android:layout_gravity="bottom"
                                android:layout_marginLeft="10dp"
                                android:layout_marginRight="10dp"
                                android:layout_marginBottom="10dp"
                                android:fontFamily="@font/montserratsemibold"
                                android:gravity="left"
                                android:text=""
                                android:textColor="@color/BlackSviut"
                                android:textSize="14sp" />

                            <ImageView
                                android:id="@+id/ImageAddTopHome2"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:src="@drawable/plus_insert_add_rectangle_icon" />
                        </androidx.cardview.widget.CardView>


                        <androidx.cardview.widget.CardView
                            android:id="@+id/CardHomeArticle3"
                            android:foreground="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="5dp"
                            android:layout_width="192dp"
                            android:layout_height="180dp"
                            android:layout_marginLeft="20dp"
                            app:cardCornerRadius="8dp">
                            <ImageView
                                android:id="@+id/ImageHomeArticle3"
                                android:layout_width="match_parent"
                                android:scaleType="centerCrop"
                                android:layout_height="124dp" />
                            <TextView
                                android:id="@+id/TextHomeArticle3"
                                android:layout_width="match_parent"
                                android:layout_height="37dp"
                                android:layout_gravity="bottom"
                                android:layout_marginLeft="10dp"
                                android:layout_marginRight="10dp"
                                android:layout_marginBottom="10dp"
                                android:fontFamily="@font/montserratsemibold"
                                android:gravity="left"
                                android:text=""
                                android:textColor="@color/BlackSviut"
                                android:textSize="14sp" />

                            <ImageView
                                android:id="@+id/ImageAddTopHome3"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:src="@drawable/plus_insert_add_rectangle_icon" />
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/CardHomeArticle4"
                            android:foreground="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="5dp"
                            android:layout_width="192dp"
                            android:layout_height="180dp"
                            android:layout_marginLeft="20dp"
                            app:cardCornerRadius="8dp">
                            <ImageView
                                android:id="@+id/ImageHomeArticle4"
                                android:layout_width="match_parent"
                                android:scaleType="centerCrop"
                                android:layout_height="124dp" />
                            <TextView
                                android:id="@+id/TextHomeArticle4"
                                android:layout_width="match_parent"
                                android:layout_height="37dp"
                                android:layout_gravity="bottom"
                                android:layout_marginLeft="10dp"
                                android:layout_marginRight="10dp"
                                android:layout_marginBottom="10dp"
                                android:fontFamily="@font/montserratsemibold"
                                android:gravity="left"
                                android:text=""
                                android:textColor="@color/BlackSviut"
                                android:textSize="14sp" />

                            <ImageView
                                android:id="@+id/ImageAddTopHome4"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:src="@drawable/plus_insert_add_rectangle_icon" />
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/CardHomeArticle5"
                            android:foreground="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="5dp"
                            android:layout_width="192dp"
                            android:layout_height="180dp"
                            android:layout_marginLeft="20dp"
                            app:cardCornerRadius="8dp">
                            <ImageView
                                android:id="@+id/ImageHomeArticle5"
                                android:layout_width="match_parent"
                                android:scaleType="centerCrop"
                                android:layout_height="124dp" />
                            <TextView
                                android:id="@+id/TextHomeArticle5"
                                android:layout_width="match_parent"
                                android:layout_height="37dp"
                                android:layout_gravity="bottom"
                                android:layout_marginLeft="10dp"
                                android:layout_marginRight="10dp"
                                android:layout_marginBottom="10dp"
                                android:fontFamily="@font/montserratsemibold"
                                android:gravity="left"
                                android:text=""
                                android:textColor="@color/BlackSviut"
                                android:textSize="14sp" />

                            <ImageView
                                android:id="@+id/ImageAddTopHome5"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:src="@drawable/plus_insert_add_rectangle_icon" />
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </HorizontalScrollView>


                <LinearLayout
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="5dp"
                    android:layout_height="wrap_content">
                    <androidx.cardview.widget.CardView
                        android:visibility="visible"
                        android:layout_marginRight="5dp"
                        android:layout_marginBottom="2dp"
                        android:layout_width="wrap_content"
                        android:layout_gravity="center"
                        app:cardElevation="1dp"
                        app:cardCornerRadius="50dp"
                        android:backgroundTint="@color/MainYellow"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="2dp"
                            android:layout_marginRight="8dp"
                            android:layout_marginLeft="8dp"
                            android:textColor="@color/BlackSviut"
                            android:fontFamily="@font/montserrat_bold"
                            android:textSize="14dp"
                            android:text="2"
                            />
                    </androidx.cardview.widget.CardView>
                    <TextView
                        android:textStyle="bold"
                        android:id="@+id/TextviewSectionName2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_gravity="center"
                        android:fontFamily="@font/montserrat_bold"
                        android:text=""
                        android:textColor="@color/SecondGrayText"
                        android:textSize="16dp"
                        app:layout_constraintBottom_toTopOf="@+id/horizontalScrollView"
                        app:layout_constraintStart_toStartOf="parent" />
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="5dp"
                        android:layout_width="16dp"
                        android:src="@drawable/arrow_forward_ios24px"
                        android:layout_height="16dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_marginTop="16dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <Button
                            android:id="@+id/SelectSectionHomeButton2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_semibold"
                            android:textSize="12dp"
                            app:icon="@drawable/library_add24px"
                            android:layout_marginLeft="16dp"
                            app:iconTint = "@color/white"
                            app:iconGravity = "textStart"
                            app:iconSize = "16dp"
                            android:layout_gravity="left"
                            android:backgroundTint="@color/MainBlue"
                            android:textColor="@color/white"
                            android:text="выбрать раздел"/>
                    </FrameLayout>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/RecycleviewSectionArticle"
                    android:layout_marginTop="5dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginBottom="2dp"

                    android:layout_width="match_parent"
                    tools:listitem="@layout/listviewhomearticle"
                    android:layout_height="wrap_content"/>



                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_marginTop="40dp"
                    android:layout_marginLeft="30dp"
                    android:layout_marginRight="30dp"
                    app:cardCornerRadius="10dp"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="10dp"
                        android:layout_gravity="center"
                        android:layout_marginRight="15dp"
                        android:layout_marginBottom="10dp"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/montserratsemibold"
                            android:gravity="left"
                            android:text="Последнее изменение:"
                            android:textColor="@color/black"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/LastEditText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left"
                            android:fontFamily="@font/montserratsemibold"
                            android:gravity="left"
                            android:layout_marginLeft="5dp"
                            android:text=""
                            android:textColor="@color/MainBlue"
                            android:textSize="18sp" />
                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <Button
                    android:id="@+id/SaveTopPostRedactButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:gravity="center"
                    android:layout_marginRight="25dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginLeft="25dp"
                    android:textSize="12dp"
                    android:textColor="@color/MainBlue"
                    android:backgroundTint="@color/secondBlue"
                    android:layout_gravity="bottom"
                    android:fontFamily="@font/montserratsemibold"
                    android:text="Сохранить изменения"/>

            </LinearLayout>
            </ScrollView>
        </FrameLayout>

    </LinearLayout>
    </ScrollView>
    </LinearLayout>
</FrameLayout>