<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".StafFunction.TopPostRedactActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp">
            <ImageView
                android:clickable="true"
                android:id="@+id/imagebackEditHome"
                android:layout_width="40dp"
                android:layout_gravity="right"
                android:layout_height="40dp"
                android:src="@mipmap/ic_close_foreground"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_marginTop="7dp"
                android:layout_marginLeft="10dp"
                android:fontFamily="@font/montserratsemibold"
                android:gravity="left"
                android:text="Главная страница"
                android:textColor="@color/BlackSviut"
                android:textSize="16sp" />

            <ProgressBar
                android:visibility="gone"
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyle"
                android:layout_gravity="right"
                android:layout_marginTop="8dp"
                android:layout_marginRight="10dp"
                android:indeterminateTint="@color/MainBlue"
                android:layout_width="25dp"
                android:layout_height="25dp" />
        </FrameLayout>


    <ScrollView
        android:overScrollMode="always"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">



        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ScrollView
                android:layout_width="match_parent"
                android:scrollbars="none"
                android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/normalidadextended1thin"
                        android:text="Учебник"
                        android:textColor="@color/MainGrayText"
                        android:textSize="18dp" />

                    <androidx.cardview.widget.CardView
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_marginRight="10dp"
                        android:layout_marginTop="20dp"
                        app:cardCornerRadius="6dp"
                        android:backgroundTint="@color/secondBlue"
                        android:layout_marginBottom="5dp"
                        android:layout_gravity="right"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="4dp"
                            android:layout_marginRight="5dp"
                            android:layout_marginLeft="5dp"
                            android:textColor="@color/MainBlue"
                            android:fontFamily="@font/montserratsemibold"
                            android:textSize="13dp"
                            android:text="Редактирование"
                            />
                    </androidx.cardview.widget.CardView>
                </FrameLayout>



                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none">
                    <LinearLayout
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"


                        android:orientation="horizontal"
                        android:paddingRight="20dp">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/CardHomeArticle1"
                            android:foreground="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="5dp"
                            android:layout_width="192dp"
                            android:layout_height="180dp"
                            android:layout_marginLeft="20dp"
                            app:cardCornerRadius="8dp">
                            <ImageView
                                android:scaleType="centerCrop"
                                android:clickable="false"
                                android:id="@+id/ImageHomeArticle1"
                                android:layout_width="match_parent"
                                android:layout_height="124dp" />
                            <TextView
                                android:id="@+id/TextHomeArticle1"
                                android:layout_width="match_parent"
                                android:layout_height="37dp"
                                android:layout_gravity="bottom"
                                android:layout_marginLeft="10dp"
                                android:layout_marginRight="10dp"
                                android:layout_marginBottom="10dp"
                                android:fontFamily="@font/montserratsemibold"
                                android:gravity="left"
                                android:text=""
                                android:textColor="@color/BlackSviut"
                                android:textSize="14sp" />

                            <ImageView
                                android:id="@+id/ImageAddTopHome1"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:src="@drawable/plus_insert_add_rectangle_icon" />
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/CardHomeArticle2"
                            android:foreground="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="5dp"
                            android:layout_width="192dp"
                            android:layout_height="180dp"
                            android:layout_marginLeft="20dp"
                            app:cardCornerRadius="8dp">
                            <ImageView

                                android:id="@+id/ImageHomeArticle2"
                                android:layout_width="match_parent"
                                android:scaleType="centerCrop"
                                android:layout_height="124dp" />
                            <TextView
                                android:id="@+id/TextHomeArticle2"
                                android:layout_width="match_parent"
                                android:layout_height="37dp"
                                android:layout_gravity="bottom"
                                android:layout_marginLeft="10dp"
                                android:layout_marginRight="10dp"
                                android:layout_marginBottom="10dp"
                                android:fontFamily="@font/montserratsemibold"
                                android:gravity="left"
                                android:text=""
                                android:textColor="@color/BlackSviut"
                                android:textSize="14sp" />

                            <ImageView
                                android:id="@+id/ImageAddTopHome2"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:src="@drawable/plus_insert_add_rectangle_icon" />
                        </androidx.cardview.widget.CardView>


                        <androidx.cardview.widget.CardView
                            android:id="@+id/CardHomeArticle3"
                            android:foreground="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="5dp"
                            android:layout_width="192dp"
                            android:layout_height="180dp"
                            android:layout_marginLeft="20dp"
                            app:cardCornerRadius="8dp">
                            <ImageView
                                android:id="@+id/ImageHomeArticle3"
                                android:layout_width="match_parent"
                                android:scaleType="centerCrop"
                                android:layout_height="124dp" />
                            <TextView
                                android:id="@+id/TextHomeArticle3"
                                android:layout_width="match_parent"
                                android:layout_height="37dp"
                                android:layout_gravity="bottom"
                                android:layout_marginLeft="10dp"
                                android:layout_marginRight="10dp"
                                android:layout_marginBottom="10dp"
                                android:fontFamily="@font/montserratsemibold"
                                android:gravity="left"
                                android:text=""
                                android:textColor="@color/BlackSviut"
                                android:textSize="14sp" />

                            <ImageView
                                android:id="@+id/ImageAddTopHome3"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:src="@drawable/plus_insert_add_rectangle_icon" />
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/CardHomeArticle4"
                            android:foreground="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="5dp"
                            android:layout_width="192dp"
                            android:layout_height="180dp"
                            android:layout_marginLeft="20dp"
                            app:cardCornerRadius="8dp">
                            <ImageView
                                android:id="@+id/ImageHomeArticle4"
                                android:layout_width="match_parent"
                                android:scaleType="centerCrop"
                                android:layout_height="124dp" />
                            <TextView
                                android:id="@+id/TextHomeArticle4"
                                android:layout_width="match_parent"
                                android:layout_height="37dp"
                                android:layout_gravity="bottom"
                                android:layout_marginLeft="10dp"
                                android:layout_marginRight="10dp"
                                android:layout_marginBottom="10dp"
                                android:fontFamily="@font/montserratsemibold"
                                android:gravity="left"
                                android:text=""
                                android:textColor="@color/BlackSviut"
                                android:textSize="14sp" />

                            <ImageView
                                android:id="@+id/ImageAddTopHome4"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:src="@drawable/plus_insert_add_rectangle_icon" />
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/CardHomeArticle5"
                            android:foreground="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="5dp"
                            android:layout_width="192dp"
                            android:layout_height="180dp"
                            android:layout_marginLeft="20dp"
                            app:cardCornerRadius="8dp">
                            <ImageView
                                android:id="@+id/ImageHomeArticle5"
                                android:layout_width="match_parent"
                                android:scaleType="centerCrop"
                                android:layout_height="124dp" />
                            <TextView
                                android:id="@+id/TextHomeArticle5"
                                android:layout_width="match_parent"
                                android:layout_height="37dp"
                                android:layout_gravity="bottom"
                                android:layout_marginLeft="10dp"
                                android:layout_marginRight="10dp"
                                android:layout_marginBottom="10dp"
                                android:fontFamily="@font/montserratsemibold"
                                android:gravity="left"
                                android:text=""
                                android:textColor="@color/BlackSviut"
                                android:textSize="14sp" />

                            <ImageView
                                android:id="@+id/ImageAddTopHome5"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:src="@drawable/plus_insert_add_rectangle_icon" />
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </HorizontalScrollView>



                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/normalidadextended1thin"
                        android:text="Тренировки"
                        android:textColor="@color/MainGrayText"
                        android:textSize="18dp"
                        app:layout_constraintBottom_toTopOf="@+id/horizontalScrollView2"
                        app:layout_constraintStart_toStartOf="parent" />

                    <androidx.cardview.widget.CardView
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_marginRight="10dp"
                        android:layout_marginTop="10dp"
                        app:cardCornerRadius="6dp"
                        android:backgroundTint="@color/secondBlue"
                        android:layout_marginBottom="5dp"
                        android:layout_gravity="right"
                        android:layout_height="wrap_content">
                        <TextView

                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="4dp"
                            android:layout_marginRight="5dp"
                            android:layout_marginLeft="5dp"
                            android:textColor="@color/RedExit"
                            android:fontFamily="@font/montserratsemibold"
                            android:textSize="13dp"
                            android:text="Недоступно"
                            />
                    </androidx.cardview.widget.CardView>
                </FrameLayout>



                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none">

                    <LinearLayout
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:paddingRight="20dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="192dp"
                            android:layout_height="180dp"
                            android:layout_marginLeft="20dp"
                            app:cardCornerRadius="8dp"
                            tools:layout_editor_absoluteX="1dp"
                            tools:layout_editor_absoluteY="444dp">
                            <ImageButton
                                android:layout_width="match_parent"
                                android:layout_height="124dp"
                                app:srcCompat="@drawable/training1"
                                tools:layout_editor_absoluteX="59dp"
                                tools:layout_editor_absoluteY="448dp" />

                            <TextView
                                android:layout_width="160dp"
                                android:layout_height="37dp"
                                android:layout_gravity="bottom"
                                android:layout_marginLeft="10dp"
                                android:layout_marginBottom="10dp"
                                android:fontFamily="@font/montserratsemibold"
                                android:gravity="left"
                                android:text="Сила и выносливость"
                                android:textColor="@color/BlackSviut"
                                android:textSize="14sp" />
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:layout_width="192dp"
                            android:layout_height="180dp"
                            android:layout_marginLeft="20dp"
                            android:layout_marginRight="50dp"
                            app:cardCornerRadius="8dp"
                            tools:layout_editor_absoluteX="1dp"
                            tools:layout_editor_absoluteY="444dp">

                            <ImageButton

                                android:layout_width="match_parent"

                                android:layout_height="124dp"
                                app:srcCompat="@drawable/training1"
                                tools:layout_editor_absoluteX="59dp"
                                tools:layout_editor_absoluteY="448dp" />

                            <TextView

                                android:layout_width="160dp"
                                android:layout_height="37dp"
                                android:layout_gravity="bottom"
                                android:layout_marginLeft="10dp"
                                android:layout_marginBottom="10dp"
                                android:fontFamily="@font/montserratsemibold"
                                android:gravity="left"
                                android:text="Координация"
                                android:textColor="@color/BlackSviut"
                                android:textSize="14sp" />
                        </androidx.cardview.widget.CardView>



                    </LinearLayout>
                </HorizontalScrollView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_marginTop="40dp"
                    android:layout_marginLeft="30dp"
                    android:layout_marginRight="30dp"
                    app:cardCornerRadius="10dp"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="10dp"
                        android:layout_gravity="center"
                        android:layout_marginRight="15dp"
                        android:layout_marginBottom="10dp"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/montserratsemibold"
                            android:gravity="left"
                            android:text="Последнее изменение:"
                            android:textColor="@color/black"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/LastEditText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left"
                            android:fontFamily="@font/montserratsemibold"
                            android:gravity="left"
                            android:layout_marginLeft="5dp"
                            android:text=""
                            android:textColor="@color/MainBlue"
                            android:textSize="18sp" />
                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <Button
                    android:id="@+id/SaveTopPostRedactButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:gravity="center"
                    android:layout_marginRight="25dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginLeft="25dp"
                    android:textSize="12dp"
                    android:textColor="@color/MainBlue"
                    android:backgroundTint="@color/secondBlue"
                    android:layout_gravity="bottom"
                    android:fontFamily="@font/montserratsemibold"
                    android:text="Сохранить изменения"/>

            </LinearLayout>
            </ScrollView>
        </FrameLayout>

    </LinearLayout>
    </ScrollView>
    </LinearLayout>
</FrameLayout>