<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/MainGray"
    tools:context=".BasedScreen">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="-30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="67dp">

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"


                    android:fontFamily="@font/nulshockbd"
                    android:text="STEPLIFE"
                    android:textSize="24dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.cardview.widget.CardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_vertical"

                    android:layout_marginLeft="20dp"
                    app:cardCornerRadius="50dp">

                    <ImageView
                        android:id="@+id/imageView2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:srcCompat="@drawable/user__1_" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="right"
                    android:layout_marginTop="15dp"
                    android:layout_marginRight="20dp"
                    android:backgroundTint="@color/mainGrayOpacity"
                    app:cardCornerRadius="50dp">

                    <ImageView
                        android:id="@+id/imageView4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:srcCompat="@drawable/free_icon_gear_1160356" />
                </androidx.cardview.widget.CardView>


            </FrameLayout>


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp"

                android:background="@drawable/videoframestyle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/nulshockbd"
                    android:text="Видео инструкция"
                    android:textColor="@color/BlackSviut"
                    android:textSize="17dp" />

                <TextView
                    android:id="@+id/textView8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="260dp"
                    android:fontFamily="@font/nulshockbd"
                    android:text="╳ Больше не показывать"
                    android:textColor="@color/BlackSviut"
                    android:textSize="15dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="370dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center"


                    app:cardCornerRadius="15dp">

                    <ImageButton
                        android:id="@+id/imageButton4"
                        android:layout_width="370dp"

                        android:layout_height="215dp"
                        android:background="@drawable/cornerdefault"

                        android:scaleType="fitXY"

                        app:srcCompat="@drawable/buttonimage" />
                </androidx.cardview.widget.CardView>


            </FrameLayout>

            <TextView
                android:id="@+id/textTeach"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginLeft="20dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/nulshockbd"
                android:text="Учебник"
                android:textColor="@color/MainGrayText"
                android:textSize="18dp"
                app:layout_constraintBottom_toTopOf="@+id/horizontalScrollView"
                app:layout_constraintStart_toStartOf="parent" />


            <HorizontalScrollView
                android:id="@+id/horizontalScrollView"
                android:layout_width="match_parent"

                android:layout_height="155dp"
                android:layout_marginTop="5dp"
                android:scrollbars="none"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"


                    android:paddingTop="5dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="150dp"
                        android:layout_height="140dp"
                        android:layout_marginLeft="20dp"
                        app:cardCornerRadius="8dp"
                        tools:layout_editor_absoluteX="1dp"
                        tools:layout_editor_absoluteY="444dp">

                        <ImageButton
                            android:id="@+id/imageButton22"
                            android:layout_width="match_parent"

                            android:layout_height="95dp"
                            app:srcCompat="@drawable/buttonimage"
                            tools:layout_editor_absoluteX="59dp"
                            tools:layout_editor_absoluteY="448dp" />

                        <TextView
                            android:id="@+id/textView22"
                            android:layout_width="113dp"
                            android:layout_height="37dp"
                            android:layout_gravity="bottom"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="0dp"
                            android:fontFamily="@font/nulshockbd"
                            android:gravity="left"
                            android:text="Как получить протез бесплатно?"
                            android:textColor="@color/MainGrayText"
                            android:textSize="11dp" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="150dp"
                        android:layout_height="140dp"
                        android:layout_marginLeft="10dp"
                        app:cardCornerRadius="8dp"
                        tools:layout_editor_absoluteX="1dp"
                        tools:layout_editor_absoluteY="444dp">

                        <ImageButton
                            android:id="@+id/imageButton5"
                            android:layout_width="match_parent"

                            android:layout_height="95dp"
                            app:srcCompat="@drawable/buttonimage"
                            tools:layout_editor_absoluteX="59dp"
                            tools:layout_editor_absoluteY="448dp" />

                        <TextView
                            android:id="@+id/textView5"
                            android:layout_width="113dp"
                            android:layout_height="37dp"
                            android:layout_gravity="bottom"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="0dp"
                            android:fontFamily="@font/nulshockbd"
                            android:gravity="left"
                            android:text="Подготовка к ампутации"
                            android:textColor="@color/MainGrayText"
                            android:textSize="11dp" />
                    </androidx.cardview.widget.CardView>


                    <androidx.cardview.widget.CardView
                        android:layout_width="150dp"
                        android:layout_height="140dp"
                        android:layout_marginLeft="10dp"
                        app:cardCornerRadius="8dp"
                        tools:layout_editor_absoluteX="1dp"
                        tools:layout_editor_absoluteY="444dp">

                        <ImageButton
                            android:id="@+id/imageButton11"
                            android:layout_width="match_parent"

                            android:layout_height="95dp"
                            app:srcCompat="@drawable/buttonimage"
                            tools:layout_editor_absoluteX="59dp"
                            tools:layout_editor_absoluteY="448dp" />

                        <TextView
                            android:id="@+id/textView24"
                            android:layout_width="113dp"
                            android:layout_height="37dp"
                            android:layout_gravity="bottom"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="0dp"
                            android:fontFamily="@font/nulshockbd"
                            android:gravity="left"
                            android:text="Как получить протез бесплатно?"
                            android:textColor="@color/MainGrayText"
                            android:textSize="11dp" />
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/textView6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/nulshockbd"
                android:text="☰ Все статьи"
                android:textColor="@color/MainBlue"
                android:textSize="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/horizontalScrollView" />

            <TextView
                android:id="@+id/textView"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/nulshockbd"
                android:text="Тренировки"
                android:textColor="@color/MainGrayText"
                android:textSize="18dp"
                app:layout_constraintBottom_toTopOf="@+id/horizontalScrollView2"
                app:layout_constraintStart_toStartOf="parent" />

            <HorizontalScrollView
                android:id="@+id/horizontalScrollView2"
                android:layout_width="413dp"
                android:layout_height="150dp"
                android:layout_marginTop="10dp"
                android:scrollbars="none"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/horizontalScrollView">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="150dp"
                        android:layout_height="140dp"
                        android:layout_marginLeft="20dp"
                        app:cardCornerRadius="8dp"
                        tools:layout_editor_absoluteX="1dp"
                        tools:layout_editor_absoluteY="444dp">

                        <ImageButton
                            android:id="@+id/imageButton24"
                            android:layout_width="match_parent"

                            android:layout_height="95dp"
                            app:srcCompat="@drawable/buttonimage"
                            tools:layout_editor_absoluteX="59dp"
                            tools:layout_editor_absoluteY="448dp" />

                        <TextView
                            android:id="@+id/textView10"
                            android:layout_width="113dp"
                            android:layout_height="37dp"
                            android:layout_gravity="bottom"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="0dp"
                            android:fontFamily="@font/nulshockbd"
                            android:gravity="left"
                            android:text="Сила и выносливость"
                            android:textColor="@color/MainGrayText"
                            android:textSize="11dp" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="150dp"
                        android:layout_height="140dp"
                        android:layout_marginLeft="10dp"
                        app:cardCornerRadius="8dp"
                        tools:layout_editor_absoluteX="1dp"
                        tools:layout_editor_absoluteY="444dp">

                        <ImageButton
                            android:id="@+id/imageButton23"
                            android:layout_width="match_parent"

                            android:layout_height="95dp"
                            app:srcCompat="@drawable/buttonimage"
                            tools:layout_editor_absoluteX="59dp"
                            tools:layout_editor_absoluteY="448dp" />

                        <TextView
                            android:id="@+id/textView23"
                            android:layout_width="113dp"
                            android:layout_height="37dp"
                            android:layout_gravity="bottom"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="0dp"
                            android:fontFamily="@font/nulshockbd"
                            android:gravity="left"
                            android:text="Координация"
                            android:textColor="@color/MainGrayText"
                            android:textSize="11dp" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="150dp"
                        android:layout_height="140dp"
                        android:layout_marginLeft="10dp"
                        app:cardCornerRadius="8dp"
                        tools:layout_editor_absoluteX="1dp"
                        tools:layout_editor_absoluteY="444dp">

                        <ImageButton
                            android:id="@+id/imageButton21"
                            android:layout_width="match_parent"

                            android:layout_height="95dp"
                            app:srcCompat="@drawable/buttonimage"
                            tools:layout_editor_absoluteX="59dp"
                            tools:layout_editor_absoluteY="448dp" />

                        <TextView
                            android:id="@+id/textView21"
                            android:layout_width="113dp"
                            android:layout_height="37dp"
                            android:layout_gravity="bottom"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="0dp"
                            android:fontFamily="@font/nulshockbd"
                            android:gravity="left"
                            android:text="Сила и выносливость"
                            android:textColor="@color/MainGrayText"
                            android:textSize="11dp" />
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </HorizontalScrollView>


            <TextView
                android:id="@+id/textView9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/nulshockbd"
                android:text="☰ Все тренировки"
                android:textColor="@color/MainBlue"
                android:textSize="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/horizontalScrollView2" />


            <Button

                android:id="@+id/buttonConnect"
                android:layout_width="370dp"
                android:layout_height="50dp"
                android:layout_gravity="center"

                android:layout_marginTop="20dp"
                android:background="@drawable/buttonstyle2"
                android:text="Подключить коленный модуль"
                android:textColor="@color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="20dp"
                android:text="Подключите коленный модуль Steplife для его настройки и кастомизации"
                android:textColor="@color/MainGrayText"
                android:textSize="16dp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editTextTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:inputType="time" />


        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>