<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/MainGray"
    tools:context=".ui.CheckNewArticleFragment">


    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/montserratsemibold"
                android:text="Финальный вид"
                android:textColor="@color/BlackSviut"
                android:textSize="17sp" />

            <ImageView

                android:clickable="true"
                android:id="@+id/imagebackAddArticle"
                android:layout_width="27dp"
                android:layout_marginLeft="5dp"
                android:rotationY="180"
                android:layout_gravity="left"
                android:layout_marginTop="12dp"

                android:layout_marginBottom="10dp"
                android:layout_height="27dp"
                android:src="@drawable/font_angle_small_right"/>

            <ImageView

                android:id="@+id/imageAddArticlePublic"
                android:clickable="true"

                android:layout_width="27dp"
                android:layout_marginRight="5dp"

                android:layout_gravity="right"
                android:layout_marginTop="12dp"

                android:layout_marginBottom="10dp"
                android:layout_height="27dp"
                android:src="@drawable/font_angle_small_right"/>
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ScrollView
                android:layout_width="match_parent"
                android:overScrollMode="never"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:layout_height="match_parent">
                    <TextView
                        android:id="@+id/TextViewHeaderFinal"
                        android:clickable="false"

                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Заголовок"
                        android:fontFamily="@font/montserratsemibold"
                        android:textColor="@color/BlackSviut"
                        android:background="@null"
                        android:textSize="26dp" />

                    <TextView
                        android:contextClickable="false"
                        android:layout_marginTop="10dp"
                        android:id="@+id/TextViewDate"
                        android:paddingLeft="10dp"
                        android:clickable="false"
                        android:paddingRight="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Дата публикации"
                        android:fontFamily="@font/montserratregular"
                        android:textColor="@color/MainGrayText"
                        android:background="@null"
                        android:textSize="12dp" />

                    <TextView
                        android:contextClickable="false"
                        android:layout_marginTop="10dp"
                        android:lineHeight="24dp"
                        android:id="@+id/TextViewMainTextEditorFinal"
                        android:paddingLeft="10dp"
                        android:clickable="false"
                        android:paddingRight="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Здесь можно написать свои мысли..."
                        android:fontFamily="@font/montserratregular"
                        android:textColor="@color/BlackSviut"
                        android:background="@null"
                        android:textSize="15dp" />

                </LinearLayout>
            </ScrollView>

        </FrameLayout>
    </LinearLayout>


</FrameLayout>