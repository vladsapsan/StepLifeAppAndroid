<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".EditArticlesActiviti">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp">
            <ImageView

                android:clickable="true"
                android:id="@+id/imagebackEditArticles"
                android:layout_width="40dp"
                android:layout_gravity="right"
                android:layout_height="40dp"
                android:src="@mipmap/ic_close_foreground"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_marginTop="7dp"
                android:layout_marginLeft="10dp"
                android:fontFamily="@font/montserratsemibold"
                android:gravity="left"
                android:text="Выбор статей на первой полосе"
                android:textColor="@color/BlackSviut"
                android:textSize="16sp" />
        </FrameLayout>





        <FrameLayout
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <Button
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:gravity="center"
                    android:layout_marginRight="25dp"
                    android:layout_marginLeft="25dp"
                    android:textSize="12dp"
                    android:textColor="@color/MainBlue"
                    android:backgroundTint="@color/secondBlue"
                    android:layout_gravity="bottom"
                    android:fontFamily="@font/montserratsemibold"
                    android:text="Статьи домашней страницы"/>

                <Button
                    android:id="@+id/TopPostRedactButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:gravity="center"
                    android:layout_marginRight="25dp"
                    android:layout_marginLeft="25dp"
                    android:textSize="12dp"
                    android:textColor="@color/MainBlue"
                    android:backgroundTint="@color/secondBlue"
                    android:layout_gravity="bottom"
                    android:fontFamily="@font/montserratsemibold"
                    android:text="Верхняя предложка учебника"/>


            </LinearLayout>
        </FrameLayout>

    </LinearLayout>
</FrameLayout>