<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:fitsSystemWindows="false"

    android:theme="@style/Theme.StepLifeApp.NoActionBar"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <fragment
        android:id="@+id/nav_host_fragment_activity_main"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toTopOf="@+id/nav_view" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/HelperButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        app:backgroundTint="@color/MainYellow"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="100dp"
        app:srcCompat="@drawable/live_help20px"/>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:layout_gravity="bottom"
        android:background="@color/white"
        app:itemTextAppearanceInactive="@color/MainGrayText"
        app:itemRippleColor="@color/MainYellowAlpha05"
        app:itemActiveIndicatorStyle="@style/App.Custom.Indicator"
        android:id="@+id/nav_view"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        app:itemIconSize="24dp"
        app:menu="@menu/bottom_nav_menu" />
</FrameLayout>