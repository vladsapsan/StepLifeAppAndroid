<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    android:layout_width="match_parent"
    android:background="@color/MainGray"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:id="@+id/HomeFragment"
    tools:context=".ui.home.HomeFragment">




    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">



            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="60dp">

                <ImageView
                    android:id="@+id/imageView3"
                    android:layout_width="wrap_content"
                    android:layout_gravity="center"
                    android:layout_height="wrap_content"
                    android:src="@drawable/logosteplifebase" />

                <androidx.cardview.widget.CardView



                    android:id="@+id/ProfileButton"
                    android:visibility="visible"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="right"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/MainGray"
                    android:layout_marginRight="20dp"

                    android:clickable="true"
                    app:cardCornerRadius="50dp">

                    <ImageView
                        android:clickable="false"
                        android:id="@+id/ImageProfile"
                        android:padding="7dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:srcCompat="@drawable/profile_user_account_people_icon_229121" />
                </androidx.cardview.widget.CardView>

                <de.hdodenhof.circleimageview.CircleImageView
                    xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:visibility="gone"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginRight="20dp"
                    android:clickable="true"

                    android:layout_gravity="right"
                    android:layout_marginTop="15dp"
                    android:src="@drawable/profile_user_account_people_icon_229121"
                    app:civ_border_width="1dp"
                    app:civ_border_color="@color/logoGray"/>





                <androidx.cardview.widget.CardView
android:visibility="gone"
                    android:layout_width="29dp"
                    android:layout_height="29dp"
                    android:layout_gravity="right"
                    android:layout_marginTop="14dp"
                    android:layout_marginRight="20dp"
                    android:backgroundTint="@color/MainGray"
                    android:clickable="true"
                    app:cardCornerRadius="50dp">

                    <ImageView

                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:srcCompat="@drawable/free_icon_gear_1160356" />
                </androidx.cardview.widget.CardView>




            </FrameLayout>


            <FrameLayout
                android:id="@+id/FrameVideoInstruction"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:animateLayoutChanges="true"
                android:background="@drawable/videoframestyle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/normalidadextended1thin"
                    android:text="Видео инструкция"
                    android:textColor="@color/BlackSviut"
                    android:textSize="16dp"
                    android:textStyle="normal" />

                <TextView

                    android:id="@+id/textHideVideoButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="260dp"
                    android:clickable="true"
                    android:fontFamily="@font/montserratregular"
                    android:text="╳ Больше не показывать"
                    android:textColor="@color/BlackSviut"
                    android:textSize="15dp" />

                <androidx.cardview.widget.CardView

                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_gravity="center"
                    android:background="@drawable/buttonstyle1"
                    app:cardCornerRadius="10dp">

                    <ImageView
                        android:id="@+id/imageButton4"
                        android:layout_width="match_parent"

                        android:layout_height="200dp"
                        android:background="@drawable/cornerdefault"

                        android:scaleType="fitXY"

                        app:srcCompat="@drawable/video" />
                </androidx.cardview.widget.CardView>


            </FrameLayout>

            <TextView
                android:id="@+id/textTeach"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginLeft="20dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/normalidadextended1thin"
                android:text="Учебник"
                android:textColor="@color/MainGrayText"
                android:textSize="18dp"
                app:layout_constraintBottom_toTopOf="@+id/horizontalScrollView"
                app:layout_constraintStart_toStartOf="parent" />



            <androidx.recyclerview.widget.RecyclerView
                android:footerDividersEnabled="false"
                android:divider="@null"
                android:paddingTop="10dp"
                android:layout_height="200dp"
                android:orientation="horizontal"
                android:listSelector="@color/white"
                android:layout_marginTop="5dp"
                tools:listitem="@layout/listviewhomearticle"
                android:animateLayoutChanges="false"
                android:id="@+id/HomeArticleListView"
                android:layout_width="match_parent">

            </androidx.recyclerview.widget.RecyclerView>

            <TextView

                android:id="@+id/AllAcricleButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="5dp"
                android:clickable="true"
                android:fontFamily="@font/montserratsemibold"
                android:text="☰ Все статьи"
                android:textColor="@color/MainBlue"
                android:textSize="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/horizontalScrollView" />

            <TextView


                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/normalidadextended1thin"
                android:text="Тренировки"
                android:textColor="@color/MainGrayText"
                android:textSize="18dp"
                app:layout_constraintBottom_toTopOf="@+id/horizontalScrollView2"
                app:layout_constraintStart_toStartOf="parent" />

            <HorizontalScrollView
                android:id="@+id/horizontalScrollView2"
                android:layout_width="413dp"
                android:layout_height="200dp"
                android:layout_marginTop="10dp"

                android:scrollbars="none"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/horizontalScrollView">

                <LinearLayout
                    android:paddingTop="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:paddingRight="20dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="192dp"
                        android:layout_height="180dp"
                        android:layout_marginLeft="20dp"
                        app:cardCornerRadius="8dp"
                        tools:layout_editor_absoluteX="1dp"
                        tools:layout_editor_absoluteY="444dp">
                        <ImageButton
                            android:layout_width="match_parent"
                            android:layout_height="124dp"
                            app:srcCompat="@drawable/training1"
                            tools:layout_editor_absoluteX="59dp"
                            tools:layout_editor_absoluteY="448dp" />

                        <TextView
                            android:layout_width="160dp"
                            android:layout_height="37dp"
                            android:layout_gravity="bottom"
                            android:layout_marginLeft="10dp"
                            android:layout_marginBottom="10dp"
                            android:fontFamily="@font/montserratsemibold"
                            android:gravity="left"
                            android:text="Сила и выносливость"
                            android:textColor="@color/BlackSviut"
                            android:textSize="14sp" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="192dp"
                        android:layout_height="180dp"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="50dp"
                        app:cardCornerRadius="8dp"
                        tools:layout_editor_absoluteX="1dp"
                        tools:layout_editor_absoluteY="444dp">

                        <ImageButton

                            android:layout_width="match_parent"

                            android:layout_height="124dp"
                            app:srcCompat="@drawable/training1"
                            tools:layout_editor_absoluteX="59dp"
                            tools:layout_editor_absoluteY="448dp" />

                        <TextView

                            android:layout_width="160dp"
                            android:layout_height="37dp"
                            android:layout_gravity="bottom"
                            android:layout_marginLeft="10dp"
                            android:layout_marginBottom="10dp"
                            android:fontFamily="@font/montserratsemibold"
                            android:gravity="left"
                            android:text="Координация"
                            android:textColor="@color/BlackSviut"
                            android:textSize="14sp" />
                    </androidx.cardview.widget.CardView>



                </LinearLayout>
            </HorizontalScrollView>


            <TextView
                android:id="@+id/textView9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="5dp"
                android:clickable="true"
                android:fontFamily="@font/montserratsemibold"
                android:text="☰ Все тренировки"
                android:textColor="@color/MainBlue"
                android:textSize="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/horizontalScrollView2" />


            <Button

                android:id="@+id/buttonConnect"
                android:layout_width="match_parent"
                android:layout_height="50dp"

                android:layout_marginRight="10dp"
                android:layout_marginLeft="10dp"
                android:layout_gravity="center"
                android:layout_marginTop="30dp"
                android:textSize="13dp"
                android:fontFamily="@font/montserratsemibold"
                android:background="@drawable/buttonstyle2"
                android:text="Подключить коленный модуль"
                android:textColor="@color/black"
                android:theme="@style/Theme.ButtonWhite"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="20dp"
                android:fontFamily="@font/montserratregular"
                android:text="Подключите коленный модуль Steplife для его настройки и кастомизации"
                android:textColor="@color/MainGrayText"
                android:textSize="15dp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:layout_gravity="center"
                android:layout_marginBottom="70dp"

                >
                <Button

                    android:id="@+id/buttonLogo1"
                    android:layout_width="51dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="15dp"
                      android:layout_marginRight="25dp"
                    android:background="@drawable/graylogoframe"
                    android:theme="@style/Theme.ButtonGrayLogo"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />
                <Button

                    android:id="@+id/buttonLogo2"
                    android:layout_width="51dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginLeft="25dp"
                    android:background="@drawable/graylogoframe"
                    android:theme="@style/Theme.ButtonGrayLogo"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />
            </FrameLayout>




        </LinearLayout>
    </ScrollView>

</FrameLayout>



