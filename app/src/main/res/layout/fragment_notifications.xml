<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@color/MainGray"
    android:layout_height="match_parent"
    android:clickable="true"
    android:id="@+id/TeachArticleFrame"
    tools:context=".ui.notifications.NotificationsFragment">
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_marginTop="0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ScrollView
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:layout_height="match_parent">
                    <FrameLayout
                        android:id="@+id/TopPostFrame"
                        android:layout_width="match_parent"
                        android:background="@color/MainYellow"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="24dp"
                            android:layout_width="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginLeft="16dp"
                            android:layout_marginRight="16dp"
                            android:layout_gravity="center_vertical"
                            android:layout_height="wrap_content">
                            <TextView
                                android:id="@+id/NameTopPost"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="left"
                                android:textStyle="bold"
                                android:text="Школа ходьбы"
                                android:textSize="22dp"
                                android:textColor="@color/BlackSviut"
                                android:fontFamily="@font/normalidad_text_text_medium"/>
                            <TextView
                                android:id="@+id/SecNameTopPost"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="left"
                                android:text="@string/TeahBook"
                                android:textSize="14dp"
                                android:textColor="@color/BlackSviut"
                                android:fontFamily="@font/montserrat_medium"/>
                        </LinearLayout>
                    </FrameLayout>

                    <androidx.legacy.widget.Space
                        android:layout_width="match_parent"
                        android:layout_height="10dp"/>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:scrollbars="none"
                        android:layout_height="wrap_content">
                    <com.google.android.material.chip.ChipGroup
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        app:singleLine="true"
                        android:id="@+id/chipGroup"
                        android:layout_marginTop="8dp"
                        app:chipSpacingVertical="0dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/TagChip1"
                            android:fontFamily="@font/montserrat_medium"
                            app:chipBackgroundColor="@color/MainGray"
                            app:chipStrokeColor="@color/MainBlue"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipCornerRadius="20dp"
                            app:checkedIconTint="@color/MainBlue"
                            app:chipSurfaceColor="@color/MainGray"
                            android:text="Полезное"/>
                        <com.google.android.material.chip.Chip
                            android:id="@+id/TagChip2"
                            app:chipBackgroundColor="@color/MainGray"
                            app:chipStrokeColor="@color/MainBlue"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipCornerRadius="20dp"
                            app:checkedIconTint="@color/MainBlue"
                            app:chipSurfaceColor="@color/MainGray"

                            android:text="Протез"/>
                        <com.google.android.material.chip.Chip
                            android:id="@+id/TagChip3"
                            app:chipBackgroundColor="@color/white"
                            app:chipStrokeColor="@color/MainBlue"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipCornerRadius="20dp"
                            app:checkedIconTint="@color/MainBlue"
                            app:chipSurfaceColor="@color/MainGray"

                            android:text="Реабилитация"/>
                        <com.google.android.material.chip.Chip
                            android:id="@+id/TagChip4"
                            app:chipBackgroundColor="@color/MainGray"
                            app:chipStrokeColor="@color/MainBlue"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipCornerRadius="20dp"
                            app:checkedIconTint="@color/MainBlue"
                            app:chipSurfaceColor="@color/MainGray"

                            android:text="Бесплатно"/>



                        <!-- Chips can be declared here, or added dynamically. -->

                    </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>




                    <androidx.legacy.widget.Space
                        android:layout_width="match_parent"
                        android:layout_height="16dp"/>

                    <aglibs.loading.skeleton.layout.SkeletonLinearLayout
                        android:id="@+id/CardArticleSection1"
                        android:layout_width="match_parent"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:orientation="horizontal"
                        android:layout_marginRight="5dp"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/TextviewSectionName1"
                            android:layout_width="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="Название"
                            android:ellipsize="end"
                            android:fontFamily="@font/normalidad_text_text_medium"
                            android:textColor="@color/SecondGrayText"
                            android:textSize="18dp" />
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_gravity="center"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_marginRight="8dp"
                                android:layout_gravity="right|center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/FullSection"
                                android:textColor="@color/MainBlue"
                                android:fontFamily="@font/montserrat_medium"/>
                        </FrameLayout>
                    </aglibs.loading.skeleton.layout.SkeletonLinearLayout>


                        <aglibs.loading.skeleton.layout.SkeletonLinearLayout
                            android:layout_width="match_parent"
                            android:orientation="horizontal"
                            android:id="@+id/SkeletonCards1"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:layout_width="192dp"
                                android:layout_height="180dp"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="16dp"
                                android:layout_marginRight="4dp"
                                android:layout_marginLeft="16dp">
                            </ImageView>
                        </aglibs.loading.skeleton.layout.SkeletonLinearLayout>


                <HorizontalScrollView
                    android:layout_width="wrap_content"
                    android:scrollbars="none"
                    android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:layout_height="wrap_content">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/RecycleviewSectionArticle1"
                        android:layout_width="wrap_content"
                        android:layout_marginRight="16dp"
                        android:layout_height="wrap_content"/>

                    <com.google.android.material.card.MaterialCardView
                        android:visibility="gone"
                        android:id="@+id/Card1Next"
                        style="@style/CustomCardViewStyle"
                        android:layout_width="178dp"
                        android:layout_height="178dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="18dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="16dp"
                        android:backgroundTint="@color/white"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardElevation="6dp"
                        app:cardPreventCornerOverlap="false"
                        app:strokeColor="@color/MainBlue"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:scaleType="centerCrop"
                                android:src="@drawable/arrow_right_alt24px" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/montserrat_medium"
                                android:gravity="center"
                                android:text="Читать все статьи раздела"
                                android:textColor="@color/BlackSviut"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
                </RelativeLayout>
                </HorizontalScrollView>


                    <aglibs.loading.skeleton.layout.SkeletonLinearLayout
                        android:id="@+id/CardArticleSection2"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_marginTop="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:orientation="horizontal"
                        android:layout_marginRight="5dp"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/TextviewSectionName2"
                            android:layout_width="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="Название"
                            android:ellipsize="end"
                            android:fontFamily="@font/normalidad_text_text_medium"
                            android:textColor="@color/SecondGrayText"
                            android:textSize="18dp" />
                        <FrameLayout
                            android:layout_gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_marginRight="8dp"
                                android:layout_gravity="right|center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/FullSection"
                                android:textColor="@color/MainBlue"
                                android:fontFamily="@font/montserrat_medium"/>
                        </FrameLayout>
                    </aglibs.loading.skeleton.layout.SkeletonLinearLayout>
                    <aglibs.loading.skeleton.layout.SkeletonLinearLayout
                        android:layout_width="match_parent"
                        android:orientation="horizontal"
                        android:id="@+id/SkeletonCards2"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="192dp"
                            android:layout_height="180dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="16dp"
                            android:layout_marginRight="4dp"
                            android:layout_marginLeft="16dp">
                        </ImageView>
                    </aglibs.loading.skeleton.layout.SkeletonLinearLayout>
                <HorizontalScrollView
                    android:layout_width="wrap_content"
                    android:scrollbars="none"
                    android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:layout_height="wrap_content">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/RecycleviewSectionArticle2"
                        android:layout_width="wrap_content"
                        android:layout_marginRight="16dp"
                        android:layout_height="wrap_content"/>
                    <com.google.android.material.card.MaterialCardView
                        android:visibility="gone"
                        android:id="@+id/Card2Next"
                        style="@style/CustomCardViewStyle"
                        android:layout_width="178dp"
                        android:layout_height="178dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="18dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="16dp"
                        android:backgroundTint="@color/white"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardElevation="6dp"
                        app:cardPreventCornerOverlap="false"
                        app:strokeColor="@color/MainBlue"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:scaleType="centerCrop"
                                android:src="@drawable/arrow_right_alt24px" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/montserrat_medium"
                                android:gravity="center"
                                android:text="Читать все статьи раздела"
                                android:textColor="@color/BlackSviut"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
                </RelativeLayout>
                </HorizontalScrollView>
                    <aglibs.loading.skeleton.layout.SkeletonLinearLayout
                        android:id="@+id/CardArticleSection3"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginRight="5dp"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/TextviewSectionName3"
                            android:layout_width="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="Название"
                            android:ellipsize="end"
                            android:fontFamily="@font/normalidad_text_text_medium"
                            android:textColor="@color/SecondGrayText"
                            android:textSize="18dp" />
                        <FrameLayout
                            android:layout_gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_marginRight="8dp"
                                android:layout_gravity="right|center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/FullSection"


                                android:textColor="@color/MainBlue"
                                android:fontFamily="@font/montserrat_medium"/>
                        </FrameLayout>
                    </aglibs.loading.skeleton.layout.SkeletonLinearLayout>
                    <aglibs.loading.skeleton.layout.SkeletonLinearLayout
                        android:layout_width="match_parent"
                        android:orientation="horizontal"
                        android:id="@+id/SkeletonCards3"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="192dp"
                            android:layout_height="180dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="16dp"
                            android:layout_marginRight="4dp"
                            android:layout_marginLeft="16dp">
                        </ImageView>
                    </aglibs.loading.skeleton.layout.SkeletonLinearLayout>
                <HorizontalScrollView
                    android:layout_width="wrap_content"
                    android:scrollbars="none"
                    android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:layout_height="wrap_content">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/RecycleviewSectionArticle3"
                        android:layout_width="wrap_content"
                        android:layout_marginRight="16dp"
                        android:layout_height="wrap_content"/>
                    <com.google.android.material.card.MaterialCardView
                        android:visibility="gone"
                        android:id="@+id/Card3Next"
                        style="@style/CustomCardViewStyle"
                        android:layout_width="178dp"
                        android:layout_height="178dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="18dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="16dp"
                        android:backgroundTint="@color/white"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardElevation="6dp"
                        app:cardPreventCornerOverlap="false"
                        app:strokeColor="@color/MainBlue"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:scaleType="centerCrop"
                                android:src="@drawable/arrow_right_alt24px" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/montserrat_medium"
                                android:gravity="center"
                                android:text="Читать все статьи раздела"
                                android:textColor="@color/BlackSviut"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
                </RelativeLayout>
                </HorizontalScrollView>

                    <Button
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginRight="20dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginLeft="20dp"
                        android:textSize="12dp"
                        app:icon="@drawable/menu24px"
                        app:iconTint = "@color/BlackSviut"
                        app:iconGravity = "textStart"
                        android:textColor="@color/BlackSviut"
                        android:backgroundTint="@color/MainYellow"
                        android:layout_gravity="bottom"
                        android:fontFamily="@font/montserrat_semibold"
                        android:text="Перейти ко всем урокам"/>

                    <Button
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginRight="20dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginLeft="20dp"
                        android:textSize="12dp"
                        app:icon="@drawable/menu24px"
                        app:iconTint = "@color/BlackSviut"
                        app:iconGravity = "textStart"
                        android:textColor="@color/BlackSviut"
                        android:backgroundTint="@color/MainYellow"
                        android:layout_gravity="bottom"
                        android:fontFamily="@font/montserrat_semibold"
                        android:text="Перейти ко всем разделам"/>

                    <LinearLayout
                        android:layout_marginTop="56dp"
                        android:layout_marginBottom="126dp"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:orientation="horizontal"
                        android:gravity="center">
                        <FrameLayout
                            android:layout_width="51dp"
                            android:layout_height="14.5dp"
                            android:layout_marginTop="7dp"
                            android:background="@drawable/log_vector_screen_small"

                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />
                        <FrameLayout
                            android:layout_width="51dp"
                            android:layout_height="14.5dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/log_vector_screen_small"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>



    </LinearLayout>
</FrameLayout>