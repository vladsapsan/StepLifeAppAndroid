<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@color/MainGray"
    android:layout_height="match_parent"

    android:id="@+id/TeachArticleFrame"
    tools:context=".ui.notifications.NotificationsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">



    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"

        android:layout_marginLeft="10dp"
        android:layout_marginRight="100dp"
        android:textSize="9dp"
        android:textColor="@color/BlackSviut"
        android:backgroundTint="@color/white"
        android:layout_gravity="bottom"
        android:fontFamily="@font/montserratsemibold"

        android:text="Получать уведомления о новых уроках"/>


    <ImageButton
        android:layout_width="40dp"
        android:backgroundTint="@color/MainGray"
        android:layout_height="40dp"
        android:layout_gravity="right"
        android:layout_marginRight="10dp"
        android:layout_marginTop="5dp"
        android:scaleType="fitCenter"
        android:src="@drawable/free_icon_font_search"/>







        </FrameLayout>

        <FrameLayout
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <ScrollView
                android:id="@+id/TeachBookScroll"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:overScrollMode="never"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:layout_height="match_parent">



                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="left"
                        android:layout_marginTop="20dp"
                        android:text="Популярно сейчас"
                        android:textSize="20dp"
                        android:layout_marginLeft="15dp"
                        android:paddingBottom="5dp"
                        android:textColor="@color/BlackSviut"
                        android:fontFamily="@font/montserratregular"/>

                    <androidx.viewpager.widget.ViewPager
                        android:overScrollMode="never"
                        android:id="@+id/viewpagerArticle"
                        android:layout_width="match_parent"
                        android:layout_height="370dp">

                    </androidx.viewpager.widget.ViewPager>

                    <me.relex.circleindicator.CircleIndicator
                        android:id="@+id/indicator"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        app:ci_drawable = "@drawable/selectedindicator"
                        android:layout_gravity="bottom"/>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="left"
                            android:layout_marginTop="10dp"
                            android:text="То, с чего стоит начать"
                            android:textSize="17dp"
                            android:layout_marginLeft="15dp"
                            android:paddingBottom="5dp"
                            android:textColor="@color/BlackSviut"
                            android:fontFamily="@font/montserratregular"/>

                        <TextView
                            android:clickable="true"
                            android:id="@+id/seeallArticleText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:textColor="@color/MainBlue"
                            android:fontFamily="@font/montserratsemibold"
                            android:textSize="13dp"
                            android:layout_marginRight="10dp"
                            android:text="Смотреть все"
                            android:layout_gravity="right"/>
                    </FrameLayout>




                    <HorizontalScrollView

                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="5dp"
                        android:overScrollMode="never"
                        android:scrollbars="none"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:paddingTop="5dp"

                            android:paddingRight="20dp">

                            <androidx.cardview.widget.CardView

                                android:layout_width="192dp"
                                android:clickable="true"
                                android:layout_height="180dp"
                                android:layout_marginLeft="20dp"
                                app:cardCornerRadius="8dp"
                                tools:layout_editor_absoluteX="1dp"
                                tools:layout_editor_absoluteY="444dp">

                                <ImageButton
                                    android:clickable="false"

                                    android:layout_width="match_parent"

                                    android:layout_height="124dp"
                                    app:srcCompat="@drawable/protez1"
                                    tools:layout_editor_absoluteX="59dp"
                                    tools:layout_editor_absoluteY="448dp" />

                                <TextView

                                    android:layout_width="160dp"
                                    android:layout_height="37dp"
                                    android:layout_gravity="bottom"
                                    android:layout_marginLeft="10dp"
                                    android:layout_marginBottom="10dp"
                                    android:fontFamily="@font/montserratsemibold"
                                    android:gravity="left"
                                    android:text="Как получить протез бесплатно?"
                                    android:textColor="@color/BlackSviut"
                                    android:textSize="14sp" />
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:layout_width="192dp"
                                android:layout_height="180dp"
                                android:layout_marginLeft="20dp"
                                app:cardCornerRadius="8dp"
                                tools:layout_editor_absoluteX="1dp"
                                tools:layout_editor_absoluteY="444dp">

                                <ImageView

                                    android:layout_width="match_parent"

                                    android:layout_height="124dp"
                                    android:scaleType="fitXY"
                                    app:srcCompat="@drawable/protez2"
                                    tools:layout_editor_absoluteX="59dp"
                                    tools:layout_editor_absoluteY="448dp"/>


                                <TextView

                                    android:layout_width="160dp"
                                    android:layout_height="37dp"
                                    android:layout_gravity="bottom"
                                    android:layout_marginLeft="10dp"
                                    android:layout_marginBottom="10dp"
                                    android:fontFamily="@font/montserratsemibold"
                                    android:gravity="left"
                                    android:text="Подготовка к ампутации"
                                    android:textColor="@color/BlackSviut"
                                    android:textSize="14sp" />
                            </androidx.cardview.widget.CardView>


                            <androidx.cardview.widget.CardView
                                android:layout_width="192dp"
                                android:layout_height="180dp"
                                android:layout_marginLeft="20dp"
                                app:cardCornerRadius="8dp"
                                tools:layout_editor_absoluteX="1dp"
                                tools:layout_editor_absoluteY="444dp">

                                <ImageButton

                                    android:layout_width="match_parent"

                                    android:layout_height="124dp"
                                    app:srcCompat="@drawable/buttonimage"
                                    tools:layout_editor_absoluteX="59dp"
                                    tools:layout_editor_absoluteY="448dp" />

                                <TextView

                                    android:layout_width="160dp"
                                    android:layout_height="37dp"
                                    android:layout_gravity="bottom"
                                    android:layout_marginLeft="10dp"
                                    android:layout_marginBottom="10dp"
                                    android:fontFamily="@font/montserratsemibold"
                                    android:gravity="left"
                                    android:text="Как получить протез бесплатно?"
                                    android:textColor="@color/BlackSviut"
                                    android:textSize="14sp" />
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </HorizontalScrollView>



                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="left"
                            android:layout_marginTop="10dp"
                            android:text="Новые статьи"
                            android:textSize="17dp"
                            android:layout_marginLeft="15dp"
                            android:paddingBottom="5dp"
                            android:textColor="@color/BlackSviut"
                            android:fontFamily="@font/montserratregular"/>

                        <TextView
                            android:id="@+id/seeallArticleText1"
                            android:clickable="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:textColor="@color/MainBlue"
                            android:fontFamily="@font/montserratsemibold"
                            android:textSize="13dp"
                            android:layout_marginRight="10dp"
                            android:text="Смотреть все"
                            android:layout_gravity="right"/>
                    </FrameLayout>


                    <HorizontalScrollView

                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="5dp"
                        android:overScrollMode="never"
                        android:scrollbars="none"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:paddingTop="5dp"

                            android:paddingRight="20dp">

                            <androidx.cardview.widget.CardView

                                android:layout_width="192dp"
                                android:clickable="true"
                                android:layout_height="180dp"
                                android:layout_marginLeft="20dp"
                                app:cardCornerRadius="8dp"
                                tools:layout_editor_absoluteX="1dp"
                                tools:layout_editor_absoluteY="444dp">

                                <ImageButton
                                    android:clickable="false"

                                    android:layout_width="match_parent"

                                    android:layout_height="124dp"
                                    app:srcCompat="@drawable/protez1"
                                    tools:layout_editor_absoluteX="59dp"
                                    tools:layout_editor_absoluteY="448dp" />

                                <TextView

                                    android:layout_width="160dp"
                                    android:layout_height="37dp"
                                    android:layout_gravity="bottom"
                                    android:layout_marginLeft="10dp"
                                    android:layout_marginBottom="10dp"
                                    android:fontFamily="@font/montserratsemibold"
                                    android:gravity="left"
                                    android:text="Как получить протез бесплатно?"
                                    android:textColor="@color/BlackSviut"
                                    android:textSize="14sp" />
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:layout_width="192dp"
                                android:layout_height="180dp"
                                android:layout_marginLeft="20dp"
                                app:cardCornerRadius="8dp"
                                tools:layout_editor_absoluteX="1dp"
                                tools:layout_editor_absoluteY="444dp">

                                <ImageView

                                    android:layout_width="match_parent"

                                    android:layout_height="124dp"
                                    android:scaleType="fitXY"
                                    app:srcCompat="@drawable/protez2"
                                    tools:layout_editor_absoluteX="59dp"
                                    tools:layout_editor_absoluteY="448dp"/>


                                <TextView

                                    android:layout_width="160dp"
                                    android:layout_height="37dp"
                                    android:layout_gravity="bottom"
                                    android:layout_marginLeft="10dp"
                                    android:layout_marginBottom="10dp"
                                    android:fontFamily="@font/montserratsemibold"
                                    android:gravity="left"
                                    android:text="Подготовка к ампутации"
                                    android:textColor="@color/BlackSviut"
                                    android:textSize="14sp" />
                            </androidx.cardview.widget.CardView>


                            <androidx.cardview.widget.CardView
                                android:layout_width="192dp"
                                android:layout_height="180dp"
                                android:layout_marginLeft="20dp"
                                app:cardCornerRadius="8dp"
                                tools:layout_editor_absoluteX="1dp"
                                tools:layout_editor_absoluteY="444dp">

                                <ImageButton

                                    android:layout_width="match_parent"

                                    android:layout_height="124dp"
                                    app:srcCompat="@drawable/buttonimage"
                                    tools:layout_editor_absoluteX="59dp"
                                    tools:layout_editor_absoluteY="448dp" />

                                <TextView
                                    android:layout_width="160dp"
                                    android:layout_height="37dp"
                                    android:layout_gravity="bottom"
                                    android:layout_marginLeft="10dp"
                                    android:layout_marginBottom="10dp"
                                    android:fontFamily="@font/montserratsemibold"
                                    android:gravity="left"
                                    android:text="Как получить протез бесплатно?"
                                    android:textColor="@color/BlackSviut"
                                    android:textSize="14sp" />
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </HorizontalScrollView>

                    <Button
                        android:id="@+id/seeallArticleButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginRight="20dp"
                        android:layout_marginLeft="20dp"
                        android:textSize="9dp"
                        android:textColor="@color/BlackSviut"
                        android:backgroundTint="@color/white"
                        android:layout_gravity="bottom"
                        android:fontFamily="@font/montserratsemibold"

                        android:text="Перейти ко всем урокам"/>
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="100dp"/>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>



    </LinearLayout>

</FrameLayout>