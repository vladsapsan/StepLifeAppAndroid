<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        app:cardCornerRadius="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="5dp"
        android:layout_marginRight="10dp"
        android:layout_height="match_parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:scaleType="centerCrop"
            android:src="@drawable/trainingphoto"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:background="@color/white"
            android:backgroundTint="@color/black"
            android:alpha="0.7"
            android:layout_gravity="bottom">
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_gravity="bottom"
            android:layout_height="130dp">
            <TextView
                android:id="@+id/ArticleHeadTextItems"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="10dp"
                android:breakStrategy="high_quality"
                android:includeFontPadding="false"
                android:fontFamily="@font/montserrat_semibold"
                android:gravity="left"
                android:text="Как получить протез бесплатно?"
                android:textColor="@color/white"
                android:textSize="18sp" />
            <androidx.cardview.widget.CardView
                xmlns:android="http://schemas.android.com/apk/res/android"
                android:foreground="?attr/selectableItemBackground"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:clickable="true"
                android:id="@+id/AddTagsArticle"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="3dp"
                android:layout_marginRight="3dp"
                android:layout_marginBottom="2dp"
                android:layout_width="wrap_content"
                app:cardCornerRadius="16dp"
                android:backgroundTint="@color/MainGray"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/TextviewTag"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="7dp"
                    android:layout_marginRight="9dp"
                    android:layout_marginLeft="9dp"
                    android:textColor="@color/MainGrayText"
                    android:fontFamily="@font/montserrat_bold"
                    android:textSize="13dp"
                    android:text="Протез"
                    />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>