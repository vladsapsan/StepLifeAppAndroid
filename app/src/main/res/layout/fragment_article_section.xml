<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clickable="true"
    android:background="@color/MainGray"
    tools:context=".ArticleSection">

    <ImageView
        android:layout_width="match_parent"
        android:src="@drawable/trainingphoto"
        android:scaleType="centerCrop"
        android:layout_height="150dp">
    </ImageView>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@color/white"
        android:backgroundTint="@color/black"
        android:alpha="0.7"
        android:layout_gravity="top"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:layout_height="60dp">


                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    style="?attr/floatingActionButtonSmallStyle"
                    android:id="@+id/BacktoButton"
                    android:layout_width="wrap_content"
                    app:backgroundTint="@color/MainGray"
                    android:layout_marginLeft="12dp"
                    android:layout_gravity="center_vertical"
                    android:rotationY="180"
                    app:fabSize="mini"
                    app:iconTint = "@color/BlackSviut"
                    app:srcCompat="@drawable/arrow_forward_ios24px"
                    android:layout_height="wrap_content"/>


                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <Button
                        android:layout_marginTop="5dp"
                        android:id="@+id/PublicationArticleButton"
                        android:layout_width="wrap_content"
                        android:layout_height="55dp"
                        android:gravity="center"
                        app:icon="@drawable/schedule24px"
                        app:iconTint = "@color/white"
                        android:textSize="12dp"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/TranspanetColor"
                        android:layout_gravity="right"
                        android:fontFamily="@font/montserratsemibold"
                        android:text="2 часа"/>
                    <ProgressBar
                        android:visibility="gone"
                        android:id="@+id/progressBar"
                        style="?android:attr/progressBarStyle"
                        android:layout_marginLeft="8dp"
                        android:layout_gravity="left|center_vertical"
                        android:indeterminateTint="@color/MainBlue"
                        android:layout_width="25dp"
                        android:layout_height="25dp" />
                </FrameLayout>



            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/NameTextSection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/montserrat_bold"
                        android:text=""
                        android:textColor="@color/white"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/TextSectionAbout"
                        android:layout_width="wrap_content"
                        android:layout_height="60dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:fontFamily="@font/montserrat_medium"
                        android:text=""
                        android:textColor="@color/white"
                        android:textSize="14sp" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginLeft="15dp"
                        android:layout_gravity="left"
                        android:fontFamily="@font/montserrat_semibold"
                        android:text="Внутри этого раздела:"
                        android:textColor="@color/BlackSviut"
                        android:textSize="16sp" />
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ListView
                            android:footerDividersEnabled="false"
                            tools:listitem="@layout/listviewarticleitem"
                            android:divider="@null"
                            android:layout_marginBottom="80dp"
                            android:paddingTop="5dp"
                            android:animateLayoutChanges="false"
                            android:id="@+id/SectionArticleListView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                    </FrameLayout>

                </LinearLayout>


            </FrameLayout>
        </LinearLayout>




</FrameLayout>