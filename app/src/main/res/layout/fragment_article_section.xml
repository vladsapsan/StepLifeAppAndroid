<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clickable="true"
    android:id="@+id/ArticleSectionFrame"
    android:background="@color/MainGray"
    tools:context=".ArticleSection">

    <ImageView
        android:layout_width="match_parent"
        android:src="@drawable/trainingphoto"
        android:scaleType="centerCrop"
        android:layout_height="166dp">
    </ImageView>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="166dp"
        android:background="@color/white"
        android:backgroundTint="@color/black"
        android:alpha="0.8"
        android:layout_gravity="top"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:layout_height="60dp">


                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    style="?attr/floatingActionButtonSmallStyle"
                    android:id="@+id/BacktoButton"
                    android:layout_width="wrap_content"
                    app:backgroundTint="@color/MainGray"
                    android:layout_marginLeft="12dp"
                    android:layout_gravity="center_vertical"
                    android:rotationY="180"
                    app:fabSize="mini"
                    app:iconTint = "@color/BlackSviut"
                    app:srcCompat="@drawable/arrow_forward_ios24px"
                    android:layout_height="wrap_content"/>


                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="left"
                    android:orientation="vertical">
                    <aglibs.loading.skeleton.layout.SkeletonLinearLayout
                        android:id="@+id/SkeletonLinearTextSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="left">
                        <TextView
                            android:layout_marginLeft="16dp"
                            android:layout_marginRight="16dp"
                            android:id="@+id/NameTextSection"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="Название раздела"
                            android:textColor="@color/white"
                            android:textSize="20sp" />
                        <androidx.legacy.widget.Space
                            android:layout_width="wrap_content"
                            android:layout_height="6dp"/>
                        <TextView
                            android:layout_marginLeft="16dp"
                            android:layout_marginRight="16dp"
                            android:id="@+id/TextSectionAbout"
                            android:layout_width="wrap_content"
                            android:layout_height="60dp"
                            android:layout_gravity="left"
                            android:gravity="left"
                            android:fontFamily="@font/montserrat_medium"
                            android:text="Описание раздела"
                            android:textColor="@color/white"
                            android:textSize="14sp" />
                    </aglibs.loading.skeleton.layout.SkeletonLinearLayout>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_gravity="left"
                        android:fontFamily="@font/montserrat_semibold"
                        android:text="Внутри этого раздела:"
                        android:textColor="@color/BlackSviut"
                        android:textSize="18sp" />
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ListView
                            android:scrollbars="none"
                            android:footerDividersEnabled="false"
                            tools:listitem="@layout/listviewarticleitem"
                            android:divider="@null"
                            android:layout_marginBottom="85dp"
                            android:paddingTop="5dp"
                            android:animateLayoutChanges="false"
                            android:id="@+id/SectionArticleListView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                    </FrameLayout>

                </LinearLayout>


            </FrameLayout>
        </LinearLayout>




</FrameLayout>