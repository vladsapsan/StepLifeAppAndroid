<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/SettingsFrame"
    android:layout_height="match_parent"
    android:background="@color/MainGray"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.SettingsFragment">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="150dp">

        <ImageView
            android:rotationY="180"
            android:id="@+id/BacktoProfile"
            android:layout_gravity="left"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="12dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/font_angle_small_right" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:paddingRight="5dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/montserrat_semibold"
            android:gravity="left"
            android:text="Настройки"
            android:textColor="@color/BlackSviut"
            android:textSize="18sp" />


        <androidx.cardview.widget.CardView
            android:id="@+id/ProfileSettingsEdit"
            android:clickable="true"
            android:animateLayoutChanges="true"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            app:cardCornerRadius="8dp"
            tools:layout_editor_absoluteX="1dp"
            tools:layout_editor_absoluteY="444dp">

            <ImageView
                android:id="@+id/imageView5"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="10dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/user__1_" />

            <TextView
                android:id="@+id/textViewEmailProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginLeft="50dp"
                android:layout_marginBottom="33dp"
                android:fontFamily="@font/montserratsemibold"
                android:gravity="left"
                android:text="Телефон"
                android:textColor="@color/BlackSviut"
                android:textSize="12sp" />

            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginLeft="50dp"
                android:layout_marginBottom="21dp"
                android:fontFamily="@font/montserratsemibold"
                android:gravity="left"
                android:text="редактировать"
                android:textColor="@color/MainBlue"
                android:textSize="11sp" />

            <ImageView

                android:layout_marginRight="5dp"
                android:layout_marginTop="26dp"
                android:layout_gravity="right"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/font_angle_small_right" />
        </androidx.cardview.widget.CardView>

    </FrameLayout>

    <FrameLayout
        android:id="@+id/SettingAboutProgramm"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_gravity="start"
        android:layout_marginTop="160dp"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/TextAboutProgramm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity=""
            android:layout_marginLeft="20dp"

            android:fontFamily="@font/montserratsemibold"
            android:gravity="left"
            android:text="О программе"
            android:textColor="@color/BlackSviut"
            android:textSize="12sp" />


        <ImageView
            android:layout_marginRight="26dp"
            android:layout_width="16dp"
            android:layout_marginTop="3dp"
            android:layout_gravity="right"
            android:layout_height="16dp"
            android:src="@drawable/font_angle_small_right" />
    </FrameLayout>




</FrameLayout>