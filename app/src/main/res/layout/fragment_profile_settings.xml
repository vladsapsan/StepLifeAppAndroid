<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/MainGray"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.ProfileSettingsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:rotationY="180"
                android:id="@+id/BacktoSettings"
                android:layout_gravity="left"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="12dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/font_angle_small_right" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/montserratsemibold"
                android:gravity="left"
                android:text="Редактировать"
                android:textColor="@color/BlackSviut"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/TextViewSaveUserinformation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:layout_marginTop="12dp"
                android:layout_marginRight="9dp"
                android:fontFamily="@font/montserratsemibold"
                android:gravity="left"
                android:text="Сохранить"
                android:textColor="@color/MainBlue"
                android:textSize="14sp" />
        </FrameLayout>

        <FrameLayout
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="500dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:visibility="gone"
                    android:layout_width="70dp"
                    app:cardCornerRadius="50dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_height="70dp"
                    >
                    <ImageView
                        android:clickable="true"

                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        app:srcCompat="@drawable/user__1_" />
                </androidx.cardview.widget.CardView>


                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ImageProfile"
                    xmlns:app="http://schemas.android.com/apk/res-auto"

                    android:layout_width="70dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_height="70dp"
                    android:clickable="true"

                    android:layout_marginTop="12dp"
                    android:src="@drawable/user__1_"
                    app:civ_border_width="1dp"
                    app:civ_border_color="@color/logoGray"/>

                <TextView
                    android:id="@+id/ChoosePhotoText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/montserratsemibold"
                    android:gravity="left"
                    android:text="Загрузить фото"
                    android:textColor="@color/MainBlue"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_marginLeft="30dp"
                    android:layout_marginRight="30dp"
                    android:layout_marginTop="50dp"
                    android:layout_height="50dp"
                    app:errorEnabled="true">
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12dp"
                        android:fontFamily="@font/montserratsemibold"
                        android:hint="Имя"
                        android:maxLength="120"
                        android:inputType="textEmailAddress"
                        android:id="@+id/editTextUserName"
                        />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>


        </FrameLayout>

    </LinearLayout>



</FrameLayout>