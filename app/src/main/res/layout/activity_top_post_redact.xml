<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".StafFunction.TopPostRedactActivity">


<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <ImageView

            android:clickable="true"
            android:id="@+id/imagebackEditTopPost"
            android:layout_width="40dp"
            android:layout_gravity="right"
            android:layout_height="40dp"
            android:src="@mipmap/ic_close_foreground"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:layout_marginTop="7dp"
            android:layout_marginLeft="10dp"
            android:fontFamily="@font/montserratsemibold"
            android:gravity="left"
            android:text="Верхняя предложка учебника"
            android:textColor="@color/BlackSviut"
            android:textSize="16sp" />

        <ProgressBar
            android:visibility="gone"
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_gravity="right"
            android:layout_marginTop="8dp"
            android:layout_marginRight="10dp"
            android:indeterminateTint="@color/MainBlue"
            android:layout_width="25dp"
            android:layout_height="25dp" />
    </FrameLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:overScrollMode="always"
        android:scrollbars="none"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_marginTop="5dp"
            app:cardCornerRadius="6dp"
            android:backgroundTint="@color/secondBlue"
            android:layout_marginBottom="5dp"
            android:layout_gravity="right"
            android:layout_height="wrap_content">
            <TextView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:layout_marginRight="5dp"
                android:layout_marginLeft="5dp"
                android:textColor="@color/MainBlue"
                android:fontFamily="@font/montserratsemibold"
                android:textSize="13dp"
                android:text="Редактирование"
                />
        </androidx.cardview.widget.CardView>

        <FrameLayout

            android:id="@+id/TopPostFrame"
            android:layout_width="match_parent"
            android:background="@color/MainGrayText"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="left"
                android:layout_height="wrap_content">
                <EditText
                    android:id="@+id/NameTopPost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="left"
                    android:layout_marginTop="20dp"
                    android:text=""
                    android:maxLines="1"
                    android:maxLength="25"
                    android:textSize="21dp"
                    android:inputType="text"
                    android:hint="Основной текст"
                    android:textColorHint="@color/white"
                    android:layout_marginLeft="15dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/montserrat1black"/>
                <EditText
                    android:id="@+id/SecNameTopPost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="left"
                    android:layout_marginTop="0dp"
                    android:maxLength="60"
                    android:hint="Дополнительный текст"
                    android:textColorHint="@color/white"
                    android:textSize="14dp"
                    android:layout_marginLeft="15dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/montserratlight"/>
