<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TopPostRedactActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp">
            <ImageView

                android:clickable="true"
                android:id="@+id/imagebackEditTopPost"
                android:layout_width="40dp"
                android:layout_gravity="right"
                android:layout_height="40dp"
                android:src="@mipmap/ic_close_foreground"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_marginTop="7dp"
                android:layout_marginLeft="10dp"
                android:fontFamily="@font/montserratsemibold"
                android:gravity="left"
                android:text="Верхняя предложка учебника"
                android:textColor="@color/BlackSviut"
                android:textSize="16sp" />

            <ProgressBar
                android:visibility="gone"
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyle"
                android:layout_gravity="right"
                android:layout_marginTop="8dp"
                android:layout_marginRight="10dp"
                android:indeterminateTint="@color/MainBlue"
                android:layout_width="25dp"
                android:layout_height="25dp" />
        </FrameLayout>



        <FrameLayout

            android:id="@+id/TopPostFrame"
            android:layout_width="match_parent"
            android:background="@color/MainGrayText"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="left"
                android:layout_height="wrap_content">
                <EditText
                    android:id="@+id/NameTopPost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="left"
                    android:layout_marginTop="20dp"
                    android:text=""
                    android:maxLines="1"
                    android:maxLength="25"
                    android:textSize="21dp"
                    android:inputType="text"
                    android:hint="Основной текст"
                    android:textColorHint="@color/white"
                    android:layout_marginLeft="15dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/montserrat1black"/>
                <EditText
                    android:id="@+id/SecNameTopPost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="left"
                    android:layout_marginTop="0dp"
                    android:maxLength="60"
                    android:hint="Дополнительный текст"
                    android:textColorHint="@color/white"
                    android:textSize="14dp"
                    android:layout_marginLeft="15dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/montserratlight"/>
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/ScrollMainViewArticles"
                android:layout_width="match_parent"
                android:layout_height="290dp"
                android:layout_marginTop="5dp"
                android:layout_gravity="bottom"
                android:scrollbars="none"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:paddingTop="5dp"
                    android:paddingRight="20dp">
                    <androidx.cardview.widget.CardView
                        android:id="@+id/TopPostCard1"
                        android:layout_width="150dp"
                        android:clickable="true"
                        android:layout_height="260dp"
                        android:layout_marginLeft="20dp"
                        app:cardCornerRadius="8dp"
                        tools:layout_editor_absoluteX="1dp"
                        tools:layout_editor_absoluteY="444dp">

                        <ImageView
                            android:id="@+id/ImageAddTop1"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:src="@drawable/plus_insert_add_rectangle_icon" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:orientation="vertical"
                            android:layout_height="match_parent">


                                <ImageView
                                    android:id="@+id/TopPostImage1"
                                    android:layout_width="match_parent"
                                    android:scaleType="fitXY"
                                    android:layout_height="130dp"/>


                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">
                                <TextView
                                    android:id="@+id/TopPostText1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_gravity="bottom"
                                    android:layout_marginLeft="10dp"
                                    android:layout_marginBottom="10dp"
                                    android:layout_marginRight="10dp"
                                    android:layout_marginTop="20dp"
                                    android:fontFamily="@font/montserratsemibold"
                                    android:gravity="left"
                                    android:text=""
                                    android:textColor="@color/black"
                                    android:textSize="14sp" />
                            </FrameLayout>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>


                    <androidx.cardview.widget.CardView
                        android:id="@+id/TopPostCard2"
                        android:layout_width="150dp"
                        android:clickable="true"
                        android:layout_height="260dp"
                        android:layout_marginLeft="20dp"
                        app:cardCornerRadius="8dp"
                        tools:layout_editor_absoluteX="1dp"
                        tools:layout_editor_absoluteY="444dp">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:src="@drawable/plus_insert_add_rectangle_icon" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:orientation="vertical"
                            android:layout_height="match_parent">

                            <androidx.cardview.widget.CardView
                                android:visibility="invisible"
                                android:layout_width="115dp"
                                app:cardCornerRadius="7dp"
                                android:layout_marginTop="15dp"
                                android:layout_gravity="center_horizontal"
                                android:layout_height="115dp"/>

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="150dp"
                        android:id="@+id/TopPostCard3"
                        android:clickable="true"
                        android:layout_height="260dp"
                        android:layout_marginLeft="20dp"
                        app:cardCornerRadius="8dp"
                        tools:layout_editor_absoluteX="1dp"
                        tools:layout_editor_absoluteY="444dp">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:src="@drawable/plus_insert_add_rectangle_icon" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:orientation="vertical"
                            android:layout_height="match_parent">

                            <androidx.cardview.widget.CardView
                                android:visibility="invisible"
                                android:layout_width="115dp"
                                app:cardCornerRadius="7dp"
                                android:layout_marginTop="15dp"
                                android:layout_gravity="center_horizontal"
                                android:layout_height="115dp"/>

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="150dp"
                        android:id="@+id/TopPostCard4"
                        android:clickable="true"
                        android:layout_height="260dp"
                        android:layout_marginLeft="20dp"
                        app:cardCornerRadius="8dp"
                        tools:layout_editor_absoluteX="1dp"
                        tools:layout_editor_absoluteY="444dp">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:src="@drawable/plus_insert_add_rectangle_icon" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:orientation="vertical"
                            android:layout_height="match_parent">

                            <androidx.cardview.widget.CardView
                                android:visibility="invisible"
                                android:layout_width="115dp"
                                app:cardCornerRadius="7dp"
                                android:layout_marginTop="15dp"
                                android:layout_gravity="center_horizontal"
                                android:layout_height="115dp"/>

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="150dp"
                        android:clickable="true"
                        android:id="@+id/TopPostCard5"
                        android:layout_height="260dp"
                        android:layout_marginLeft="20dp"
                        app:cardCornerRadius="8dp"
                        tools:layout_editor_absoluteX="1dp"
                        tools:layout_editor_absoluteY="444dp">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:src="@drawable/plus_insert_add_rectangle_icon" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:orientation="vertical"
                            android:layout_height="match_parent">

                            <androidx.cardview.widget.CardView
                                android:visibility="invisible"
                                android:layout_width="115dp"
                                app:cardCornerRadius="7dp"
                                android:layout_marginTop="15dp"
                                android:layout_gravity="center_horizontal"
                                android:layout_height="115dp"/>

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </HorizontalScrollView>

            </LinearLayout>
        </FrameLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            app:cardCornerRadius="10dp"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:orientation="vertical"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="10dp"
                android:layout_gravity="center"
                android:layout_marginRight="15dp"
                android:layout_marginBottom="10dp"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/montserratsemibold"
                    android:gravity="left"
                    android:text="Последнее изменение:"
                    android:textColor="@color/black"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/LastEditText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:fontFamily="@font/montserratsemibold"
                    android:gravity="left"
                    android:layout_marginLeft="5dp"
                    android:text=""
                    android:textColor="@color/MainBlue"
                    android:textSize="18sp" />
            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/SaveTopPostRedactButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:layout_marginRight="25dp"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="25dp"
            android:textSize="12dp"
            android:textColor="@color/MainBlue"
            android:backgroundTint="@color/secondBlue"
            android:layout_gravity="bottom"
            android:fontFamily="@font/montserratsemibold"
            android:text="Сохранить изменения"/>
    </LinearLayout>
</FrameLayout>