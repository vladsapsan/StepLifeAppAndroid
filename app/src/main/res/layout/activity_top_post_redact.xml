<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".StafFunction.Edit.TopPostRedactActivity">


<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <ImageView

            android:clickable="true"
            android:id="@+id/imagebackEditTopPost"
            android:layout_width="40dp"
            android:layout_gravity="right"
            android:layout_height="40dp"
            android:src="@mipmap/ic_close_foreground"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:layout_marginTop="7dp"
            android:layout_marginLeft="10dp"
            android:fontFamily="@font/montserratsemibold"
            android:gravity="left"
            android:text="Учебник школа ходьбы"
            android:textColor="@color/BlackSviut"
            android:textSize="16sp" />


        <ProgressBar
            android:visibility="gone"
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_gravity="right"
            android:layout_marginTop="8dp"
            android:layout_marginRight="10dp"
            android:indeterminateTint="@color/MainBlue"
            android:layout_width="25dp"
            android:layout_height="25dp" />
    </FrameLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:overScrollMode="always"
        android:scrollbars="none"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:layout_marginRight="16dp"
            android:layout_marginLeft="16dp"
            android:fontFamily="@font/montserrat_medium"
            android:gravity="left"
            android:text="Редактирование главной страницы школы ходьбы"
            android:textColor="@color/BlackSviut"
            android:textSize="14sp" />



        <androidx.cardview.widget.CardView
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="5dp"
            app:cardCornerRadius="6dp"
            android:backgroundTint="@color/secondBlue"
            android:layout_marginBottom="5dp"
            android:layout_gravity="left"
            android:layout_height="wrap_content">
            <TextView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:layout_marginRight="5dp"
                android:layout_marginLeft="5dp"
                android:textColor="@color/MainBlue"
                android:fontFamily="@font/montserratsemibold"
                android:textSize="13dp"
                android:text="Редактирование"
                />
        </androidx.cardview.widget.CardView>

        <FrameLayout

            android:id="@+id/TopPostFrame"
            android:layout_width="match_parent"
            android:background="@color/MainYellow"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="left"
                android:layout_marginBottom="16dp"
                android:layout_height="wrap_content">
                <TextView
                    android:visibility="visible"
                    android:id="@+id/NameTopPost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="left"
                    android:layout_marginTop="20dp"
                    android:text="Школа ходьбы"
                    android:textSize="21dp"
                    android:inputType="text"
                    android:layout_marginLeft="15dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/BlackSviut"
                    android:fontFamily="@font/montserrat1black"/>
                <TextView
                    android:visibility="visible"
                    android:id="@+id/SecNameTopPost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="left"
                    android:text="Авторский учебник разработанный нашими сотрудниками для вас!"
                    android:textSize="14dp"
                    android:layout_marginLeft="15dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/BlackSviut"
                    android:fontFamily="@font/montserratlight"/>
            </LinearLayout>



            </LinearLayout>
        </FrameLayout>



        <LinearLayout
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="5dp"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:visibility="visible"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_gravity="center"
                app:cardElevation="1dp"
                app:cardCornerRadius="50dp"
                android:backgroundTint="@color/MainYellow"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginLeft="8dp"
                    android:textColor="@color/BlackSviut"
                    android:fontFamily="@font/montserrat_bold"
                    android:textSize="14dp"
                    android:text="1"
                    />
            </androidx.cardview.widget.CardView>
            <TextView
                android:textStyle="bold"
                android:id="@+id/TextviewSectionName1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:fontFamily="@font/montserrat_bold"
                android:text=""
                android:textColor="@color/SecondGrayText"
                android:textSize="16dp"
                app:layout_constraintBottom_toTopOf="@+id/horizontalScrollView"
                app:layout_constraintStart_toStartOf="parent" />
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:layout_width="16dp"
                android:src="@drawable/arrow_forward_ios24px"
                android:layout_height="16dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_marginTop="16dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/SelectSectionHomeButton1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold"
                    android:textSize="12dp"
                    app:icon="@drawable/library_add24px"
                    android:layout_marginLeft="16dp"
                    app:iconTint = "@color/white"
                    app:iconGravity = "textStart"
                    app:iconSize = "16dp"
                    android:layout_gravity="left"
                    android:backgroundTint="@color/MainBlue"
                    android:textColor="@color/white"
                    android:text="выбрать раздел"/>
            </FrameLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/RecycleviewSectionArticle"
            android:layout_marginTop="5dp"
            android:layout_marginLeft="10dp"
            android:layout_marginBottom="2dp"
            android:layout_width="match_parent"
            tools:listitem="@layout/listviewhomearticle"
            android:layout_height="wrap_content"/>




        <LinearLayout
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="5dp"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:visibility="visible"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_gravity="center"
                app:cardElevation="1dp"
                app:cardCornerRadius="50dp"
                android:backgroundTint="@color/MainYellow"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginLeft="8dp"
                    android:textColor="@color/BlackSviut"
                    android:fontFamily="@font/montserrat_bold"
                    android:textSize="14dp"
                    android:text="2"
                    />
            </androidx.cardview.widget.CardView>
            <TextView
                android:textStyle="bold"
                android:id="@+id/TextviewSectionName2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:maxLines="3"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:fontFamily="@font/montserrat_bold"
                android:text=""
                android:textColor="@color/SecondGrayText"
                android:textSize="16dp"
                app:layout_constraintBottom_toTopOf="@+id/horizontalScrollView"
                app:layout_constraintStart_toStartOf="parent" />
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:layout_width="16dp"
                android:src="@drawable/arrow_forward_ios24px"
                android:layout_height="16dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_marginTop="16dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/SelectSectionHomeButton2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold"
                    android:textSize="12dp"
                    app:icon="@drawable/library_add24px"
                    android:layout_marginLeft="16dp"
                    app:iconTint = "@color/white"
                    app:iconGravity = "textStart"
                    app:iconSize = "16dp"
                    android:layout_gravity="left"
                    android:backgroundTint="@color/MainBlue"
                    android:textColor="@color/white"
                    android:text="выбрать раздел"/>
            </FrameLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/RecycleviewSectionArticle2"
            android:layout_marginTop="5dp"
            android:layout_marginLeft="10dp"
            android:layout_marginBottom="2dp"
            android:layout_width="match_parent"
            tools:listitem="@layout/listviewhomearticle"
            android:layout_height="wrap_content"/>



        <LinearLayout
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="5dp"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:visibility="visible"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_gravity="center"
                app:cardElevation="1dp"
                app:cardCornerRadius="50dp"
                android:backgroundTint="@color/MainYellow"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginLeft="8dp"
                    android:textColor="@color/BlackSviut"
                    android:fontFamily="@font/montserrat_bold"
                    android:textSize="14dp"
                    android:text="3"
                    />
            </androidx.cardview.widget.CardView>
            <TextView
                android:textStyle="bold"
                android:id="@+id/TextviewSectionName3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:fontFamily="@font/montserrat_bold"
                android:text=""
                android:textColor="@color/SecondGrayText"
                android:textSize="16dp"
                app:layout_constraintBottom_toTopOf="@+id/horizontalScrollView"
                app:layout_constraintStart_toStartOf="parent" />
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:layout_width="16dp"
                android:src="@drawable/arrow_forward_ios24px"
                android:layout_height="16dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_marginTop="16dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/SelectSectionHomeButton3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold"
                    android:textSize="12dp"
                    app:icon="@drawable/library_add24px"
                    android:layout_marginLeft="16dp"
                    app:iconTint = "@color/white"
                    app:iconGravity = "textStart"
                    app:iconSize = "16dp"
                    android:layout_gravity="left"
                    android:backgroundTint="@color/MainBlue"
                    android:textColor="@color/white"
                    android:text="выбрать раздел"/>
            </FrameLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/RecycleviewSectionArticle3"
            android:layout_marginTop="5dp"
            android:layout_marginLeft="10dp"
            android:layout_marginBottom="2dp"
            android:layout_width="match_parent"
            tools:listitem="@layout/listviewhomearticle"
            android:layout_height="wrap_content"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            app:cardCornerRadius="10dp"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:orientation="vertical"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="10dp"
                android:layout_gravity="center"
                android:layout_marginRight="15dp"
                android:layout_marginBottom="10dp"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/montserratsemibold"
                    android:gravity="left"
                    android:text="Последнее изменение:"
                    android:textColor="@color/black"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/LastEditText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:fontFamily="@font/montserratsemibold"
                    android:gravity="left"
                    android:layout_marginLeft="5dp"
                    android:text=""
                    android:textColor="@color/MainBlue"
                    android:textSize="18sp" />
            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/SaveTopPostRedactButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:layout_marginRight="25dp"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="25dp"
            android:textSize="12dp"
            android:textColor="@color/MainBlue"
            android:backgroundTint="@color/secondBlue"
            android:layout_gravity="bottom"
            android:fontFamily="@font/montserratsemibold"
            android:text="Сохранить изменения"/>
    </LinearLayout>

    </ScrollView>
</LinearLayout>
</FrameLayout>