<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:animateLayoutChanges="true"
    android:id="@+id/SheetDialogSettingsContainer"
    android:background="@drawable/bottomsheetprofilesettingbackground"
    android:layout_height="match_parent">

<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="50dp">

    <TextView

        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="20dp"
        android:fontFamily="@font/montserratregular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Действия"
        android:textColor="@color/black"
        android:textSize="13dp"/>


    <FrameLayout
        android:id="@+id/AddArticleFrameButton"
        android:layout_width="match_parent"
        android:layout_gravity="left"
        android:layout_marginTop="60dp"
        android:layout_height="30dp">
        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:layout_marginLeft="55dp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/montserratsemibold"
            android:gravity="left"

            android:text="Добавить статью в учебник"
            android:textColor="@color/BlackSviut"
            android:textSize="14sp" />

        <ImageView

            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="20dp"
            android:layout_gravity="left"

            android:src="@drawable/plus_insert_add_rectangle_icon" />
    </FrameLayout>

    <FrameLayout

        android:id="@+id/RedactArticleFrameButton"
        android:layout_width="match_parent"
        android:layout_gravity="left"
        android:layout_marginTop="100dp"
        android:layout_height="30dp">
        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:layout_marginLeft="55dp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/montserratsemibold"
            android:gravity="left"

            android:text="Редактировать статьи в учебнике"
            android:textColor="@color/BlackSviut"
            android:textSize="14sp" />

        <ImageView

            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginLeft="23dp"
            android:layout_gravity="left"

            android:src="@drawable/free_icon_font_edit" />
    </FrameLayout>


    <FrameLayout

        android:id="@+id/SettingsFrameBtn"
        android:layout_width="match_parent"
        android:layout_gravity="left"
        android:layout_marginTop="140dp"
        android:layout_height="30dp">
        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:layout_marginLeft="55dp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/montserratsemibold"
            android:gravity="left"

            android:text="Настройки"
            android:textColor="@color/BlackSviut"
            android:textSize="14sp" />

        <ImageView

            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginLeft="23dp"
            android:layout_gravity="left"

            android:src="@drawable/free_icon_font_settings" />
    </FrameLayout>

    <FrameLayout

        android:id="@+id/ExitFrameButton"
        android:layout_width="match_parent"
        android:layout_gravity="left"
        android:layout_marginTop="180dp"
        android:layout_height="30dp">
        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:layout_marginLeft="55dp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/montserratsemibold"
            android:gravity="left"

            android:text="Выйти"
            android:textColor="@color/BlackSviut"
            android:textSize="14sp" />

        <ImageView

            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="23dp"
            android:layout_gravity="left"

            android:src="@drawable/free_icon_font_exit_3917349" />
    </FrameLayout>


     <FrameLayout
         android:layout_width="60dp"
         android:layout_marginTop="5dp"
         android:layout_gravity="center_horizontal"
         android:background="@drawable/cornerdefault"
         android:layout_height="5dp"/>




</FrameLayout>

</FrameLayout>